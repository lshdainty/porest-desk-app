            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 400,
          "foreground": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          },
          "gap": 2
        },
        "suffixIcon": {
          "size": 16,
          "color": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          }
