{
  "name": "Menu",
  "source": "specs/components/menu.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "9d344caf3f10"
  },
  "slots": {
    "content": "메뉴 — 트리거 아래(모자라면 위 · 옆) 8",
    "group": "묶음 — 묶음 사이에만 선을 긋는다",
    "groupLabel": "묶음 이름 — 있을 때만, 누를 수 없다",
    "divider": "묶음 사이 선 — 줄 사이에는 없다",
    "item": "줄 — 누르면 실행하고 닫힌다. 글은 메뉴 안에서 줄바꿈된다",
    "itemIcon": "앞 아이콘 — 쓰면 모든 줄에",
    "itemLabel": "이름 — 동사로 짧게(2 ~ 6자)",
    "itemDescription": "설명 — 한 줄, 꼭 필요한 줄에만",
    "suffixIcon": "뒤 아이콘 — 바깥 링크처럼 방향을 알릴 때만",
    "highlight": "호버 · 누름 바탕 — 좌우 8 들인 알약",
    "focusRing": "키보드 포커스 링 — 알약 자리에(웹)"
  },
  "axes": {
    "tone": [
      "neutral",
      "critical"
    ]
  },
  "defaults": {
    "tone": "neutral"
  },
  "states": [
    "enabled",
    "hovered",
    "pressed",
    "focused",
    "disabled"
  ],
  "rules": [
    {
      "when": {},
      "enabled": {
        "content": {
          "width": 200,
          "background": {
            "light": "#FFFFFF",
            "dark": "#2D3346"
          },
          "radius": 20,
          "shadow": {
            "light": "0 8px 24px -4px rgba(15, 18, 28, 0.10), 0 2px 6px -2px rgba(15, 18, 28, 0.05)",
            "dark": "0 8px 24px -4px rgba(0, 0, 0, 0.50), 0 2px 6px -2px rgba(0, 0, 0, 0.25), inset 0 1px 0 0 rgba(255, 255, 255, 0.08)"
          },
          "paddingY": 8,
          "offset": 8,
          "align": "end",
          "maxHeight": "min(480px, 남은 화면)",
          "zIndex": 200
        },
        "item": {
          "paddingY": 10,
          "paddingX": 16,
          "gap": 8,
          "height": 39,
          "cursor": "pointer",
          "transitionProperty": "background-color",
          "transitionDuration": "150ms",
          "transitionEasing": "cubic-bezier(0.35, 0, 0.35, 1)"
        },
        "itemIcon": {
          "size": 18,
          "color": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          }
        },
        "itemLabel": {
          "typography": {
            "fontSize": 14,
            "lineHeight": 19,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 400,
          "foreground": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          }
        },
        "itemDescription": {
          "typography": {
            "fontSize": 12,
