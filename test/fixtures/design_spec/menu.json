      },
      "focused": {
        "focusRing": {
          "width": 2,
          "offset": -2,
          "color": {
            "light": "#0147AD",
            "dark": "#7AA9F6"
          }
        }
      },
      "disabled": {
        "item": {
          "cursor": "not-allowed"
        },
        "itemIcon": {
          "color": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "itemLabel": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "itemDescription": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "suffixIcon": {
          "color": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "highlight": {
          "background": "transparent"
        }
      }
    },
    {
      "when": {
        "tone": "critical"
      },
      "enabled": {
        "itemIcon": {
          "color": {
            "light": "#D72323",
            "dark": "#FF8477"
          }
        },
        "itemLabel": {
          "foreground": {
            "light": "#D72323",
            "dark": "#FF8477"
          }
        },
        "suffixIcon": {
          "color": {
            "light": "#D72323",
            "dark": "#FF8477"
          }
        }
      }
    }
  ],
  "motion": {
    "열림": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "scale 0.95 → 1",
        "opacity 0 → 1"
      ],
      "note": "트리거 쪽 변을 기준점으로 커진다"
    },
    "닫힘": {
      "duration": "100ms",
      "easing": "cubic-bezier(0.35, 0, 1, 1)",
      "properties": [
        "scale → 0.95",
        "opacity → 0"
      ]
    },
    "호버 알약": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "background-color"
      ]
    },
    "누름": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "scale"
      ]
    }
  },
  "notes": [
