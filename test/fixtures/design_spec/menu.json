          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          }
        }
      },
      "pressed": {
        "highlight": {
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          }
        },
        "item": {
          "scale": "콘텐츠 2px 거리 축소",
