{
  "name": "Swipe Actions",
  "source": "specs/components/swipe-actions.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "6ec6e05f538e"
  },
  "slots": {
    "row": "ⓐ 감싸는 목록 줄 — 스펙이 내부를 정의하지 않는다. 닫혔을 때 초점을 받을 수 있다(tabIndex -1)",
    "track": "ⓑ 줄 뒤에 드러나는 자리 — 바탕을 칠하지 않는다",
    "action": "ⓒ 동작 한 칸(버튼) — 원형 배지 + 그 아래 라벨, 세로 가운데. 누르는 자리는 이 칸 전체",
    "badge": "원형 배지 — 색은 여기만",
    "icon": "배지 안 아이콘",
    "label": "배지 아래 라벨",
    "moreButton": "줄 끝 ⋮ — 같은 동작을 Menu Sheet 로 여는 다른 길",
    "focusRing": "키보드 포커스 링"
  },
  "axes": {
    "kind": [
      "neutral",
      "primary",
      "destructive"
    ],
    "size": [
      "default"
    ]
  },
  "defaults": {},
  "states": [
    "enabled",
    "hovered",
    "focused",
    "pressed",
    "disabled"
  ],
  "rules": [
    {
      "when": {},
      "enabled": {
        "badge": {
          "background": "kind 색"
        },
        "action": {
          "brightness": "100%",
          "shadow": "none",
          "transform": "translateX(0)",
          "cursor": "pointer"
        },
        "moreButton": {
          "size": 40
        }
      },
      "hovered": {
        "action": {
          "brightness": "88%"
        }
      },
      "focused": {
        "focusRing": {
          "width": 2,
          "offset": -2,
          "color": {
            "light": "#0147AD",
            "dark": "#7AA9F6"
          }
        }
      },
      "pressed": {
        "action": {
          "brightness": "88%"
        }
      },
      "disabled": {
        "action": {
          "cursor": "not-allowed"
        },
        "badge": {
          "background": {
            "light": "#F5F6FA",
            "dark": "#353B4D"
          }
        },
        "icon": {
          "color": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "label": {
          "color": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        }
      }
    },
    {
