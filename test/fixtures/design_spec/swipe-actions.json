            "light": "#F5F6FA",
            "dark": "#353B4D"
          },
          "borderWidth": 1,
          "borderColor": {
            "light": "#E5E8EF",
            "dark": "#404757"
          }
        },
        "icon": {
          "color": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          }
        },
        "label": {
          "color": {
            "light": "#535866",
            "dark": "#B7BDCC"
          }
        }
      }
    },
    {
      "when": {
        "kind": "primary"
      },
      "enabled": {
        "badge": {
          "background": {
            "light": "#1D6EC9",
            "dark": "#69ABFF"
          }
        },
        "icon": {
          "color": {
            "light": "#FFFFFF",
            "dark": "#242938"
          }
        },
        "label": {
          "color": {
            "light": "#535866",
            "dark": "#B7BDCC"
          }
        }
      }
    },
    {
      "when": {
        "kind": "destructive"
      },
      "enabled": {
        "badge": {
          "background": {
            "light": "#D72323",
            "dark": "#FF8477"
          }
        },
        "icon": {
          "color": {
            "light": "#FFFFFF",
            "dark": "#242938"
          }
        },
        "label": {
          "color": {
            "light": "#D72323",
            "dark": "#FF8477"
          }
        }
      }
    },
    {
      "when": {
        "size": "default"
      },
      "enabled": {
        "action": {
          "height": "줄 높이",
          "width": "배지 + 앞 간격",
          "paddingY": 0,
          "paddingX": "앞 간격만",
          "gap": 2,
          "touchTarget": "칸 전체"
        },
        "badge": {
          "size": 36,
          "radius": 9999
        },
        "icon": {
          "size": 18
        },
        "label": {
          "typography": {
            "fontSize": 12,
            "lineHeight": 16,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 700,
          "lineHeight": 1.3
        }
      }
    }
  ],
  "motion": {
    "열림 · 닫힘": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "transform"
      ],
      "note": "모션 줄이기면 바로 — 끌기 따라가기는 모션이 아니라 그대로"
    }
  },
  "notes": [
    {
      "rule": 0,
      "state": "enabled",
      "slot": "badge",
      "prop": "background",
      "note": "바탕은 배지에만 있다 — kind 별 값은 Kinds 표"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "action",
      "prop": "transform",
      "note": "누를 때 움직이지 않는다 — 손가락으로 밀어 둔 트레이와 이중으로 움직인다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "moreButton",
      "prop": "size",
      "note": "Button ghost · iconOnly · medium — 아이콘 18(lucide ellipsis-vertical) · 누르는 영역 44 · 이름 \"{줄 이름} 더보기\" · 1280 미만이라 Menu Sheet"
    },
    {
      "rule": 0,
      "state": "focused",
      "slot": "focusRing",
      "prop": "offset",
      "note": "안쪽 — 트레이 바깥으로 나가면 줄 경계에서 잘린다"
    },
    {
      "rule": 1,
      "state": "enabled",
      "slot": "badge",
      "prop": "background",
      "note": "줄 바탕과 1.08 · 다크 1.30 이라 안쪽 1px 테두리로 둘레를 잡는다(배지는 아이콘 · 라벨로 읽힌다)"
    },
    {
      "rule": 2,
      "state": "enabled",
      "slot": "badge",
      "prop": "background",
      "note": "라이트 #1D6EC9 · 다크 #69ABFF — 줄 바탕과 5.09 · 다크 6.12(지금 다크 bg-informative-solid #0F65BF 는 2.51)"
    },
    {
      "rule": 2,
      "state": "enabled",
      "slot": "icon",
      "prop": "color",
      "note": "라이트 흰 · 다크 짙은 글자 — 배지 위 5.09 · 6.12"
    },
    {
      "rule": 2,
      "state": "enabled",
      "slot": "label",
      "prop": "color",
      "note": "주 동작도 라벨은 회색 — 색은 배지가 말한다(앱의 파랑 라벨은 스펙과 다르다)"
    },
    {
      "rule": 3,
      "state": "enabled",
      "slot": "badge",
      "prop": "background",
      "note": "라이트 #D72323 · 다크 #FF8477 — 줄 바탕과 5.06 · 다크 6.08(지금 다크 bg-critical-solid #CC0E17 은 2.51)"
    },
    {
      "rule": 3,
      "state": "enabled",
      "slot": "icon",
      "prop": "color",
      "note": "라이트 흰 · 다크 짙은 글자 — 배지 위 5.06 · 6.08"
    },
    {
      "rule": 3,
      "state": "enabled",
      "slot": "label",
      "prop": "color",
      "note": "줄 바탕 위 5.06 · 다크 6.08 — 라이트 · 다크 한 토큰(옛 error · error-light 두 벌을 걷는다)"
    },
    {
      "rule": 4,
      "state": "enabled",
      "slot": "action",
      "prop": "height",
      "note": "min 56 — 줄이 56 보다 낮으면 56"
    },
    {
      "rule": 4,
      "state": "enabled",
      "slot": "action",
      "prop": "width",
      "note": "첫 액션 56, 이후 48 — 앞 간격(첫 20 · 다음 12) + 배지 36"
    },
    {
      "rule": 4,
      "state": "enabled",
      "slot": "action",
      "prop": "paddingX",
      "note": "첫 동작 앞 20 · 동작끼리 12 — 마지막 동작은 화면 끝에 붙는다"
    },
    {
      "rule": 4,
      "state": "enabled",
      "slot": "action",
      "prop": "gap",
      "note": "배지 ↔ 라벨 2"
    },
    {
      "rule": 4,
      "state": "enabled",
      "slot": "action",
      "prop": "touchTarget",
      "note": "48 ~ 56 × 줄 높이(56 이상) — AA ✓ · AAA ✓"
    },
    {
      "rule": 4,
      "state": "enabled",
      "slot": "badge",
      "prop": "radius",
      "note": "원형"
    },
    {
      "rule": 4,
      "state": "enabled",
      "slot": "label",
      "prop": "typography",
      "note": "12 — 굵기 · 줄 높이는 이 컴포넌트의 값(12 / 700 / 1.3). 칸 폭 48 이 좁아 기본 줄 높이면 두 줄에서 넘친다"
    },
    {
      "rule": 4,
      "state": "enabled",
      "slot": "label",
      "prop": "fontWeight",
      "note": "v100 — 600 은 쓰지 않는다. 버튼 글자와 같은 700"
    },
    {
      "rule": 4,
      "state": "enabled",
      "slot": "label",
      "prop": "lineHeight",
      "note": "웹 · 앱 같은 값 — 앱의 1.5 를 고친다"
    }
  ]
