{
  "name": "QuantityPicker",
  "source": "specs/components/quantity-picker.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "8e7da59ba7f5"
  },
  "slots": {
    "root": "테두리 상자 — 줄이기 · 선 · 값 · 선 · 늘리기를 한 줄로 담는다. role=\"group\" + 이름(Field 라벨 · aria-label) 필수",
    "button": "줄이기 · 늘리기 버튼 공통 — 정사각, 상자 높이와 같다. 올림 · 누름 · 포커스 · 로딩은 그 버튼 하나에만 걸린다",
    "decrement": "줄이기 버튼(−) — 최소에서 막힘. removable 이면 최소에서 지우기(휴지통) 버튼이 된다",
    "increment": "늘리기 버튼(+) — 최대에서 막힘",
    "icon": "버튼 아이콘 — lucide minus · plus · trash-2",
    "divider": "버튼 ↔ 값 사이 세로 선",
    "value": "값 칸(Value Display) — 지금 값과 단위(\"3회\"). 보기만 한다 — 누르지도 치지도 못한다",
    "progressCircle": "로딩 원 — 서버 응답을 기다리는 버튼의 아이콘 자리",
    "focusRing": "키보드 포커스 링(웹) — 버튼 바깥"
  },
  "axes": {
    "size": [
      "small",
      "medium",
      "large",
      "responsive"
    ],
    "layout": [
      "hug",
      "fill"
    ],
    "edge": [
      "none",
      "min",
      "max"
    ],
    "removable": [
      "off",
      "on"
    ]
  },
  "defaults": {
    "size": "responsive",
    "layout": "hug",
    "edge": "none",
    "removable": "off"
  },
  "states": [
    "enabled",
    "hovered",
    "focused",
    "pressed",
    "loading",
    "invalid",
    "disabled"
  ],
  "rules": [
    {
      "when": {},
      "enabled": {
        "root": {
          "display": "inline-flex",
          "background": {
            "light": "#FFFFFF",
            "dark": "#242938"
          },
          "borderWidth": 1,
          "borderColor": {
            "light": "#E5E8EF",
            "dark": "#404757"
          },
          "role": "group"
        },
        "button": {
          "background": "transparent",
          "cursor": "pointer",
          "transitionProperty": "background-color",
          "transitionDuration": "150ms",
          "transitionEasing": "cubic-bezier(0.35, 0, 0.35, 1)",
          "repeat": "없음"
        },
        "decrement": {
          "name": "줄이기"
        },
        "increment": {
          "name": "늘리기"
        },
        "icon": {
          "color": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          }
        },
        "divider": {
          "width": 1,
          "height": 16,
          "background": {
            "light": "#EDEFF3",
            "dark": "#353B4D"
          }
        },
        "value": {
          "foreground": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          },
          "fontWeight": 500,
          "fontVariantNumeric": "tabular-nums",
          "textAlign": "center",
          "paddingX": 8,
          "minWidth": "가장 긴 값의 폭",
          "pointerEvents": "없음",
          "ariaLive": "polite"
        },
        "progressCircle": {
          "display": "none",
          "thickness": 2,
          "track": {
            "light": "#8A91A0",
            "dark": "#656B78"
          },
          "range": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          }
        }
      },
      "hovered": {
        "button": {
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          }
        }
      },
      "focused": {
        "focusRing": {
          "width": 2,
          "offset": 2,
          "color": {
            "light": "#0147AD",
            "dark": "#7AA9F6"
          }
        }
      },
      "pressed": {
        "button": {
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          },
          "scale": "2px 거리 축소",
          "scaleDuration": "150ms",
          "scaleEasing": "cubic-bezier(0, 0, 0.15, 1)"
        }
      },
      "loading": {
        "button": {
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          },
          "cursor": "progress",
          "press": "막음"
        },
        "icon": {
          "display": "none"
        },
        "progressCircle": {
          "display": "보임"
        }
      },
      "invalid": {
        "root": {
          "borderWidth": 2,
          "borderColor": {
            "light": "#D72323",
            "dark": "#FF8477"
          }
        }
      },
      "disabled": {
        "button": {
          "cursor": "not-allowed"
        },
        "icon": {
          "color": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "value": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        }
      }
    },
    {
      "when": {
        "size": "small"
      },
      "enabled": {
        "root": {
          "height": 36,
          "radius": 8
        },
        "button": {
          "size": 36,
          "radius": 8,
          "touchTarget": "44 × 44",
          "touchExtend": 4
        },
        "icon": {
          "size": 16
        },
        "value": {
          "typography": {
            "fontSize": 16,
            "lineHeight": 22,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          }
        },
        "progressCircle": {
          "size": 16
        }
      }
    },
    {
      "when": {
        "size": "medium"
      },
      "enabled": {
        "root": {
          "height": 40,
          "radius": 8
        },
        "button": {
          "size": 40,
          "radius": 8,
          "touchTarget": "44 × 44",
          "touchExtend": 2
        },
        "icon": {
          "size": 18
        },
        "value": {
          "typography": {
            "fontSize": 16,
            "lineHeight": 22,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          }
        },
        "progressCircle": {
          "size": 18
        }
      }
    },
    {
      "when": {
        "size": "large"
      },
      "enabled": {
        "root": {
          "height": 52,
          "radius": 12
        },
        "button": {
          "size": 52,
          "radius": 12,
          "touchTarget": "52 × 52",
          "touchExtend": 0
        },
        "icon": {
          "size": 22
        },
        "value": {
          "typography": {
            "fontSize": 18,
            "lineHeight": 24,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          }
        },
        "progressCircle": {
          "size": 22
        }
      }
    },
    {
      "when": {
        "size": "responsive"
      },
      "enabled": {
        "root": {
          "breakpoint": 1280
        }
      }
    },
    {
      "when": {
        "layout": "fill"
      },
      "enabled": {
        "root": {
          "width": "남은 폭"
        },
        "value": {
          "flexGrow": 1
        }
      }
    },
    {
      "when": {
        "edge": "min"
      },
      "enabled": {
        "decrement": {
          "ariaDisabled": "true",
          "cursor": "not-allowed",
          "iconColor": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        }
      },
      "hovered": {
        "decrement": {
          "background": "transparent"
        }
      },
      "pressed": {
        "decrement": {
          "background": "transparent",
          "scale": "없음"
        }
      }
    },
    {
      "when": {
        "edge": "max"
      },
      "enabled": {
        "increment": {
          "ariaDisabled": "true",
          "cursor": "not-allowed",
          "iconColor": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        }
      },
      "hovered": {
        "increment": {
          "background": "transparent"
        }
      },
      "pressed": {
        "increment": {
          "background": "transparent",
          "scale": "없음"
        }
      }
    },
    {
      "when": {
        "removable": "on",
        "edge": "min"
      },
      "enabled": {
        "decrement": {
          "icon": "trash-2",
          "name": "removeAriaLabel",
          "ariaDisabled": "false",
          "cursor": "pointer",
          "iconColor": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          }
        }
      },
      "hovered": {
        "decrement": {
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          }
        }
      },
      "pressed": {
        "decrement": {
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          },
          "scale": "2px 거리 축소"
        }
      },
      "disabled": {
        "decrement": {
          "cursor": "not-allowed",
          "iconColor": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        }
      }
    }
  ],
  "motion": {
    "누름 · 올림 — 바탕": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "background-color"
      ],
      "note": "SEED colorDuration · colorTimingFunction — 누른 버튼만"
    },
    "누름 — 버튼 축소": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "scale"
      ],
      "note": "누른 버튼만 2px 거리 축소(v104) — 모션 줄이기면 하지 않는다"
    }
  },
  "notes": [
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "display",
      "note": "− · 선 · 값 · 선 · + 를 한 줄 가운데 정렬 — 줄을 바꾸지 않는다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "background",
      "note": "SEED 와 같다 — 시트 · 대화상자(bg-layer-floating) 위에서도 이 색이다(다크 시트 위 상자가 한 단계 어둡다)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "borderWidth",
      "note": "상자 안쪽에 그린다(inset) — 오류의 2px 도 안쪽이라 내용이 밀리지 않는다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "borderColor",
      "note": "Input 의 테두리와 같다 — 흰 면 1.23 · 다크 1.56, 칸을 알리는 유일한 표시가 아니다(두 버튼 아이콘이 알린다)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "role",
      "note": "이름 필수 — Field 안이면 라벨이 이름(aria-labelledby), 아니면 aria-label(\"승인 필요 횟수\")"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "button",
      "prop": "background",
      "note": "SEED bg.transparent"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "button",
      "prop": "repeat",
      "note": "한 번 누르면 한 단계 — 누르고 있어도 반복하지 않는다(사용자 결정 2A, 길게 누르기 2C 는 고르지 않았다)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "decrement",
      "prop": "name",
      "note": "아이콘만 있는 버튼 — 이름 \"줄이기\"(decrementAriaLabel 로 바꿀 수 있다)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "increment",
      "prop": "name",
      "note": "이름 \"늘리기\"(incrementAriaLabel)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "icon",
      "prop": "color",
      "note": "lucide minus · plus — 흰 면 16.41 · 다크 13.42, 누름 바탕 위 15.48 · 10.32"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "divider",
      "prop": "height",
      "note": "SEED x4 16 — 크기와 관계없이 같다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "divider",
      "prop": "background",
      "note": "장식 — 버튼과 값을 가른다(흰 면 1.15 · 다크 1.30)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "value",
      "prop": "fontWeight",
      "note": "SEED medium"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "value",
      "prop": "fontVariantNumeric",
      "note": "숫자 폭이 같아 값이 바뀌어도 글이 흔들리지 않는다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "value",
      "prop": "paddingX",
      "note": "SEED x2 8 — 세 크기 같다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "value",
      "prop": "minWidth",
      "note": "가장 긴 표시 글(getValueText(min) 과 getValueText(max) — \"99회\" · \"24h\")을 숨겨 둔 자리 글로 폭을 잡는다(SEED valueDisplayPlaceholder) — 값이 바뀌어도 상자 폭이 그대로다. max 를 주지 않으면(기본 Number.MAX_SAFE_INTEGER — 열여섯 자리) max 글은 빼고 min 과 지금 값으로 잡는다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "value",
      "prop": "pointerEvents",
      "note": "보기만 — 누르지도 치지도 못한다(SEED \"Value Display는 터치에 반응하지 않습니다\", 사용자 결정 2A). 치는 값 칸(2B)은 고르지 않았다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "value",
      "prop": "ariaLive",
      "note": "aria-atomic=true — 바뀐 값(단위 글 그대로 \"4회\")을 한 번 읽는다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "progressCircle",
      "prop": "display",
      "note": "로딩일 때만 — 아이콘 자리에"
