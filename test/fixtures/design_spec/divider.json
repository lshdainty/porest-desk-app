{
  "name": "Divider",
  "source": "specs/components/divider.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "9d344caf3f10"
  },
  "slots": {
    "root": "1px 선 — 바깥 여백이 없다(사이 간격은 쓰는 자리가 정한다)"
  },
  "axes": {
    "orientation": [
      "horizontal",
      "vertical"
    ],
    "inset": [
      "full",
      "inset"
    ]
  },
  "defaults": {
    "orientation": "horizontal",
    "inset": "full"
  },
  "states": [
    "enabled"
  ],
  "rules": [
    {
      "when": {},
      "enabled": {
        "root": {
          "thickness": 1,
          "background": {
            "light": "#EDEFF3",
            "dark": "#353B4D"
          },
          "margin": 0
        }
      }
    },
    {
      "when": {
        "orientation": "horizontal"
      },
      "enabled": {
        "root": {
          "width": "100%"
        }
      }
    },
    {
      "when": {
        "orientation": "vertical"
      },
      "enabled": {
        "root": {
          "height": "부모 높이"
        }
      }
    },
    {
      "when": {
        "orientation": "horizontal",
        "inset": "inset"
      },
      "enabled": {
        "root": {
          "marginX": 16
        }
      }
    },
    {
      "when": {
        "orientation": "vertical",
        "inset": "inset"
      },
      "enabled": {
        "root": {
          "marginY": 16
        }
      }
    }
  ],
  "notes": [
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "thickness",
      "note": "모든 방향 · 모든 자리 1 — 굵은 선을 두지 않는다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "background",
      "note": "흰 바탕 1.15 · 다크 1.30(SEED 기본 neutral-muted 1.15 와 같은 진하기) — 장식이라 3:1 대상이 아니다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "margin",
      "note": "선 위아래 · 좌우 간격은 쓰는 자리가 정한다(들임만 Divider 가 갖는다)"
    },
    {
      "rule": 1,
      "state": "enabled",
      "slot": "root",
      "prop": "width",
      "note": "부모 폭 — 높이 1"
    },
    {
      "rule": 2,
      "state": "enabled",
      "slot": "root",
      "prop": "height",
      "note": "부모가 높이를 정한다(flex 안에서 늘어난다 — 부모 높이가 없으면 선이 0 이 된다). 폭 1"
    },
    {
      "rule": 3,
      "state": "enabled",
      "slot": "root",
      "prop": "marginX",
      "note": "양끝 16(SEED inset) — 선 폭은 부모 폭 − 32(100% 에 여백을 더하지 않는다). 화면 여백 24 안의 내용에 맞출 때는 쓰는 자리가 여백을 더한다"
    },
    {
      "rule": 4,
      "state": "enabled",
      "slot": "root",
      "prop": "marginY",
      "note": "위아래 16"
    }
  ]
}
