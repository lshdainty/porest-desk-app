  },
  "slots": {
    "root": "바 — 화면 아래에 떠 있는 알약. 칸 다섯을 똑같이 나눈다",
    "item": "탭 칸 — 아이콘 + 라벨. 누르면 그 탭으로(지금 탭이면 맨 위 + 그 탭의 첫 화면)",
    "icon": "탭 아이콘 — lucide 선 아이콘",
    "label": "탭 라벨 — 한글 5자 이내 · 글자 크기 설정을 따르지 않는다",
    "addButton": "가운데 + — 브랜드 원. 그 화면의 추가(거래 추가 · 일정 추가) — 탭이 아니다",
    "addIcon": "+ 아이콘 — 흰색",
    "notification": "탭의 알림 — Notification Badge(점 · 숫자). 2칸까지",
    "bodyInset": "본문 아래 여백 — 셸이 본문 스크롤에 준다. 마지막 줄이 바 위로 올라온다",
    "focusRing": "키보드 포커스 링(웹)"
  },
  "axes": {
    "size": [
      "regular",
      "compact"
    ],
    "selected": [
      "unselected",
      "selected"
    ]
  },
  "defaults": {
    "size": "regular",
    "selected": "unselected"
  },
  "states": [
    "enabled",
    "pressed",
    "focused"
  ],
  "rules": [
    {
      "when": {},
