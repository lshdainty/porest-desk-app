        "height",
        "margin",
        "padding"
      ],
      "note": "라벨은 줄어들기 시작할 때 사라지고 다 펴진 뒤 나타난다. 모션 줄이기면 바로 바뀐다"
    },
    "누름 — 칸": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "scale"
      ],
      "note": "2px 거리 축소 — 모션 줄이기면 하지 않는다"
    },
    "누름 — +": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "background-color",
        "scale"
      ]
    }
  },
