        "addButton": {
          "size": 36
        },
        "addIcon": {
          "size": 20
        }
      }
    },
    {
      "when": {
        "selected": "selected"
      },
      "enabled": {
        "icon": {
          "color": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
