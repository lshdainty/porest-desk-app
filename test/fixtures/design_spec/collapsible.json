{
  "name": "Collapsible",
  "source": "specs/components/collapsible.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "3b3b74b34b25"
  },
  "slots": {
    "root": "접는 자리 하나 — 트리거 + 펼친 내용. surface card 면 Card 면",
    "heading": "머리말 — 트리거를 감싼다(heading > button). 모양은 없다",
    "trigger": "트리거 — 줄 전체가 누르는 자리(button). Accordion 항목과 같은 모양",
    "background": "트리거 바탕 층 — 누름 · 호버 바탕. 줄지 않는다",
    "content": "트리거 콘텐츠 층 — 본문 · 꺾쇠. 누르면 이 층만 준다",
    "body": "본문 — 이름 + 설명",
    "title": "이름 — 무엇을 여닫는지. 상태마다 바꾸지 않는다",
    "description": "설명 — 있을 때만(합계 · 적용한 필터 수)",
    "chevron": "꺾쇠 — 오른쪽 끝. 펼치면 위를 가리킨다",
    "panel": "펼친 내용 — 높이로 펼치고 접는다. 안에서 스크롤하지 않는다",
    "divider": "트리거 위 선 — 경고 상자 아래 줄일 때만",
    "box": "경고 상자 — surface warning 일 때 Collapsible 을 품는 상자(분할 합계 경고). 위에 경고 글, 아래 줄이 트리거",
    "focusRing": "키보드 포커스 링(웹) — 트리거 안쪽"
  },
  "axes": {
    "open": [
      "collapsed",
      "expanded"
    ],
    "description": [
      "none",
      "shown"
    ],
    "layout": [
      "text",
      "rows"
    ],
    "surface": [
      "default",
      "card",
      "warning"
    ]
  },
  "defaults": {
    "open": "collapsed",
    "description": "none",
    "layout": "text",
    "surface": "default"
  },
  "states": [
    "enabled",
    "hovered",
    "focused",
    "pressed",
    "disabled"
  ],
  "rules": [
    {
      "when": {},
      "enabled": {
        "heading": {
          "level": "h3"
        },
        "trigger": {
          "minHeight": 54,
          "paddingY": 16,
          "paddingX": 24,
          "textAlign": "left",
          "cursor": "pointer",
          "touchTarget": "트리거 전체"
        },
        "background": {
          "background": "transparent",
          "insetX": 0,
          "radius": 0,
          "transitionProperty": "background-color, inset, border-radius",
          "transitionDuration": "150ms",
          "transitionEasing": "cubic-bezier(0.35, 0, 0.35, 1)"
        },
        "content": {
          "gap": 12,
          "alignItems": "center",
          "transitionProperty": "scale",
          "transitionDuration": "150ms",
          "transitionEasing": "cubic-bezier(0, 0, 0.15, 1)"
        },
        "body": {
          "gap": 2
        },
        "title": {
          "typography": {
            "fontSize": 16,
            "lineHeight": 22,
            "fontWeight": 500,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 500,
          "foreground": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          },
          "lineClamp": "none"
        },
        "description": {
          "typography": {
            "fontSize": 13,
            "lineHeight": 18,
            "fontWeight": 500,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 500,
          "foreground": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          },
          "lineClamp": "none"
        },
        "chevron": {
          "size": 20,
          "color": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          },
          "rotate": "0deg",
          "transitionProperty": "rotate",
          "transitionDuration": "300ms",
          "transitionEasing": "cubic-bezier(0.35, 0, 0.35, 1)"
        },
        "panel": {
          "display": "숨김",
          "paddingTop": 0,
          "paddingX": 24,
          "paddingBottom": 16,
          "maxHeight": "none"
        }
      },
      "hovered": {
        "background": {
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          },
          "insetX": 6,
          "radius": 10
        }
      },
      "pressed": {
        "background": {
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          },
          "insetX": 6,
          "radius": 10
        },
        "content": {
          "scale": "2px 거리 축소"
        }
      },
      "focused": {
        "focusRing": {
          "width": 2,
          "offset": -2,
          "color": {
            "light": "#0147AD",
            "dark": "#7AA9F6"
          },
          "radius": 0
        }
      },
      "disabled": {
        "trigger": {
          "cursor": "not-allowed"
        },
        "title": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "description": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "chevron": {
          "color": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        }
      }
    },
    {
      "when": {
        "open": "expanded"
      },
      "enabled": {
        "chevron": {
          "rotate": "180deg"
        },
        "panel": {
          "display": "보임"
        }
      }
    },
    {
      "when": {
        "description": "shown"
      },
      "enabled": {
        "trigger": {
          "minHeight": 74
        }
      }
    },
    {
      "when": {
        "layout": "rows"
      },
      "enabled": {
        "panel": {
          "paddingBottom": 8
        }
      }
    },
    {
      "when": {
        "surface": "card"
      },
      "enabled": {
        "root": {
          "background": {
            "light": "#FFFFFF",
            "dark": "#242938"
          },
          "borderWidth": 1,
          "borderColor": {
            "light": "#E5E8EF",
            "dark": "#404757"
          },
          "radius": 16,
          "overflow": "hidden"
        },
        "panel": {
          "paddingBottom": 24
        }
      },
      "focused": {
        "focusRing": {
          "radius": 14
        }
      }
    },
    {
      "when": {
        "surface": "warning"
      },
      "enabled": {
        "box": {
          "background": {
            "light": "#FFEFE8",
            "dark": "#4B2B1F"
          },
          "borderWidth": 1,
          "borderColor": {
            "light": "#F5C7B6",
            "dark": "#833615"
          },
          "radius": 12,
          "overflow": "hidden",
          "paddingTop": 14,
          "paddingX": 16,
          "paddingBottom": 12
        },
        "trigger": {
          "paddingX": 16
        },
        "panel": {
          "paddingX": 16
        },
        "divider": {
          "height": 1,
          "background": {
            "light": "#F5C7B6",
            "dark": "#833615"
          },
          "display": "트리거 위"
        }
      },
      "hovered": {
        "background": {
          "background": {
            "light": "#FAE0D5",
            "dark": "#65321D"
          }
        }
      },
      "pressed": {
        "background": {
          "background": {
            "light": "#FAE0D5",
            "dark": "#65321D"
          }
        }
      },
      "focused": {
        "focusRing": {
          "radius": 10
        }
      }
    }
  ],
  "motion": {
    "펼침 · 접힘 — 높이": {
      "duration": "300ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "height"
      ],
      "note": "Accordion 과 같다(사용자 결정 3A) — 펼쳐도 초점 · 스크롤은 그대로"
    },
    "꺾쇠 — 회전": {
      "duration": "300ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "rotate"
      ],
      "note": "0 → 180° — 모션 줄이기면 바로 뒤집힌다"
    },
    "모션 줄이기 — 펼침 · 접힘": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "opacity"
      ],
      "note": "높이를 움직이지 않고 150ms 서서히(v104)"
    },
    "누름 · 호버 — 바탕": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "background-color",
        "inset",
        "border-radius"
      ]
    },
    "누름 — 콘텐츠": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "scale"
      ],
      "note": "모션 줄이기면 하지 않는다"
    }
  },
  "notes": [
