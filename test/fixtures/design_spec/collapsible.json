    {
      "rule": 5,
      "state": "enabled",
      "slot": "box",
      "prop": "radius",
      "note": "12 — 지금 분할 경고 상자의 모서리"
    },
    {
      "rule": 5,
      "state": "enabled",
      "slot": "box",
      "prop": "overflow",
      "note": "아래 줄의 누름 바탕 · 펼친 내용을 모서리에서 자른다"
    },
    {
      "rule": 5,
      "state": "enabled",
      "slot": "box",
      "prop": "paddingTop",
      "note": "경고 글 위 14"
    },
    {
      "rule": 5,
      "state": "enabled",
      "slot": "box",
      "prop": "paddingX",
      "note": "경고 글 좌우 16 — 트리거 좌우와 같다"
    },
    {
      "rule": 5,
      "state": "enabled",
      "slot": "box",
      "prop": "paddingBottom",
      "note": "경고 글 ↔ 아래 줄의 선 12"
    },
    {
      "rule": 5,
      "state": "enabled",
      "slot": "trigger",
      "prop": "paddingX",
      "note": "경고 상자의 안쪽 여백 16 — 상자 글과 같은 자리에 선다"
    },
    {
      "rule": 5,
      "state": "enabled",
      "slot": "divider",
      "prop": "background",
      "note": "트리거 위 — 상자 안 경고 글과 트리거 줄을 가른다"
