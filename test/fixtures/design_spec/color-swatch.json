        }
      }
    },
    {
      "when": {
        "color": "brown"
      },
      "enabled": {
        "swatch": {
          "background": {
            "light": "#9A6536",
            "dark": "#CF9F77"
          }
        }
      }
    },
    {
      "when": {
        "color": "gray"
      },
      "enabled": {
        "swatch": {
          "background": {
            "light": "#62697A",
            "dark": "#B7BDCC"
          }
        }
      }
    },
    {
      "when": {
        "selected": "selected"
      },
      "enabled": {
        "check": {
          "display": "보임"
        },
        "ring": {
          "display": "보임"
        }
      },
