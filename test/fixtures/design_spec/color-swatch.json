{
  "name": "Color Swatch",
  "source": "specs/components/color-swatch.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "853c4f4d30e9"
  },
  "slots": {
    "group": "묶음 — radiogroup, 5 × 2 격자. 이름은 Field 라벨(\"색상\")",
    "swatch": "색 칸 — 원 40, 누르는 44. 이름은 색 이름",
    "check": "체크 — 고른 칸 가운데",
    "ring": "고른 고리 — 칸 바깥 2 띄워 2px",
    "current": "지금 색 칸 — 팔레트 밖 색(\"지금 색\") · 색 없음(\"자동\"). 격자 앞, 묶음의 첫 칸",
    "currentLabel": "지금 색 칸 아래 글",
    "divider": "지금 색 칸 ↔ 격자 사이 세로 선",
    "focusRing": "키보드 포커스 링 — 고리 바깥"
  },
  "axes": {
    "color": [
      "red",
      "orange",
      "yellow",
      "green",
      "blue",
      "indigo",
      "violet",
      "pink",
      "brown",
      "gray"
    ],
    "selected": [
      "unselected",
      "selected"
    ],
    "current": [
      "none",
      "custom",
      "auto"
    ]
  },
  "defaults": {
    "color": "red",
    "selected": "unselected",
    "current": "none"
  },
  "states": [
    "enabled",
    "hovered",
    "focused",
    "pressed",
    "disabled"
  ],
  "rules": [
    {
      "when": {},
      "enabled": {
        "group": {
          "columns": 5,
          "gap": 12,
          "width": 248,
          "order": "색상환",
          "keyboard": "← → · ↑ ↓"
        },
        "swatch": {
          "size": 40,
          "radius": 9999,
          "touchTarget": "44 × 44",
          "cursor": "pointer",
          "name": "색 이름",
          "tooltip": "색 이름"
        },
        "check": {
          "size": 16,
          "strokeWidth": 2.5,
          "color": {
            "light": "#FFFFFF",
            "dark": "#242938"
          },
          "display": "숨김"
        },
        "ring": {
          "outlineWidth": 2,
          "outlineOffset": 2,
          "outlineColor": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          },
          "display": "숨김"
        },
        "currentLabel": {
          "typography": {
            "fontSize": 12,
            "lineHeight": 16,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "foreground": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          },
          "marginTop": 6
        },
        "divider": {
          "width": 1,
          "color": {
            "light": "#E5E8EF",
            "dark": "#404757"
          },
          "gap": 16,
          "stackBelow": 321
        }
      },
      "pressed": {
        "swatch": {
          "scale": "칸 2px 거리 축소",
          "scaleDuration": "150ms",
          "scaleEasing": "cubic-bezier(0, 0, 0.15, 1)"
        }
      },
      "focused": {
        "focusRing": {
          "width": 2,
          "offset": 6,
          "color": {
            "light": "#0147AD",
            "dark": "#7AA9F6"
          }
        }
      },
      "disabled": {
        "swatch": {
          "cursor": "not-allowed"
        }
      }
    },
    {
      "when": {
        "color": "red"
      },
      "enabled": {
        "swatch": {
          "background": {
            "light": "#D72323",
            "dark": "#FF8477"
          }
        }
      }
    },
    {
      "when": {
