{
  "name": "HelpBubble",
  "source": "specs/components/help-bubble.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "9d344caf3f10"
  },
  "slots": {
    "root": "말풍선 — 짙은 바탕, 트리거 쪽에 화살표",
    "arrow": "화살표 — 늘 트리거 가운데를 가리킨다",
    "title": "제목 — 툴팁은 이것 하나",
    "description": "설명 — Help Bubble 에서 제목을 풀어 줄 때만",
    "closeButton": "닫기 — Help Bubble 에서만, 오른쪽 위 모서리. 이름 \"닫기\"",
    "focusRing": "키보드 포커스 링(웹)"
  },
  "axes": {
    "opens": [
      "press",
      "hover"
    ],
    "closeButton": [
      "hidden",
      "shown"
    ]
  },
  "defaults": {
    "opens": "press",
    "closeButton": "hidden"
  },
  "states": [
    "enabled",
    "pressed",
    "focused"
  ],
  "rules": [
    {
      "when": {},
      "enabled": {
        "root": {
          "maxWidth": 280,
          "paddingY": 10,
          "paddingX": 12,
          "radius": 12,
          "background": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          },
          "shadow": "none",
          "offset": 4,
          "margin": 16,
          "zIndex": 210
        },
        "arrow": {
          "width": 12,
          "height": 8,
          "margin": 14
        },
        "title": {
          "typography": {
            "fontSize": 13,
            "lineHeight": 18,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 700,
          "foreground": {
            "light": "#FFFFFF",
            "dark": "#242938"
          }
        },
        "description": {
          "typography": {
            "fontSize": 13,
            "lineHeight": 18,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 400,
          "foreground": {
            "light": "#FFFFFF",
            "dark": "#242938"
          },
          "gap": 2
        }
      },
      "focused": {
        "focusRing": {
          "width": 2,
          "offset": -2,
          "color": {
            "light": "#FFFFFF",
            "dark": "#242938"
          },
          "rootOffset": 2,
          "rootColor": {
            "light": "#0147AD",
            "dark": "#7AA9F6"
          }
        }
      }
    },
    {
      "when": {
        "opens": "hover"
      },
      "enabled": {
        "root": {
          "openDelay": "200ms",
          "closeDelay": "100ms",
          "skipDelay": "300ms"
        }
      }
    },
    {
      "when": {
        "opens": "press",
        "closeButton": "shown"
      },
      "enabled": {
        "closeButton": {
          "size": 38,
          "touchTarget": "44 × 44",
          "iconSize": 14,
          "radius": 12,
          "color": {
            "light": "#FFFFFF",
            "dark": "#242938"
          }
        }
      },
      "pressed": {
        "closeButton": {
          "scale": "2px 거리 축소",
          "scaleDuration": "150ms",
          "scaleEasing": "cubic-bezier(0, 0, 0.15, 1)"
        }
      }
    }
  ],
  "motion": {
    "열림": {
      "duration": "200ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "scale 0.9 → 1",
        "opacity 0 → 1"
      ],
      "note": "화살표 끝을 기준점으로 커진다 — 툴팁이 이어서 열리면 모션 없이 바로"
    },
    "닫힘": {
      "duration": "200ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "opacity → 0"
      ],
      "note": "크기는 그대로, 투명도만"
    }
  },
  "notes": [
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "maxWidth",
      "note": "여백을 포함한 폭 — 한 줄 20자 안팎, 2 ~ 3줄이면 넘지 않는다. 쓸 수 있는 폭(화면 − 양쪽 16)이 더 좁으면 그만큼(SEED 와 같다)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "background",
      "note": "다크에서는 밝은 말풍선"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "offset",
      "note": "화살표 끝 ↔ 트리거 4(말풍선 몸통과는 12)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "margin",
      "note": "화면 가장자리와 최소 16 — 모자라면 반대편으로 뒤집고 옆으로 민다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "zIndex",
      "note": "z-tooltip — specs/z-index.md L4"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "arrow",
      "prop": "height",
      "note": "끝 모서리 2 — 말풍선과 같은 색. 트리거와 4 는 이 상자의 끝에서 잰다 — 둥근 끝 때문에 그림 끝은 1 더 떨어져 보인다(SEED 와 같다)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "arrow",
      "prop": "margin",
      "note": "말풍선 모서리에서 최소 14 — 트리거가 작아 모자라면 말풍선을 민다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "title",
      "prop": "typography",
      "note": "단어 단위 줄바꿈(v114) · 줄바꿈 문자는 그대로"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "description",
      "prop": "gap",
      "note": "제목 ↔ 설명"
    },
    {
      "rule": 0,
      "state": "focused",
      "slot": "focusRing",
      "prop": "offset",
      "note": "닫기 버튼 안쪽"
    },
    {
      "rule": 0,
      "state": "focused",
      "slot": "focusRing",
      "prop": "color",
      "note": "말풍선 글자색 — 브랜드 링(stroke-focus-ring)은 짙은 말풍선 위에서 Desk 1.96 · HR 3.24 로 3:1 에 못 미친다"
    },
    {
      "rule": 0,
      "state": "focused",
      "slot": "focusRing",
      "prop": "rootOffset",
      "note": "닫기 버튼이 없는 말풍선에 Tab 으로 들어오면 말풍선 둘레 바깥 2(모서리를 따라)"
    },
    {
      "rule": 0,
      "state": "focused",
      "slot": "focusRing",
      "prop": "rootColor",
      "note": "페이지 위에 그려지므로 브랜드 링"
    },
    {
      "rule": 1,
      "state": "enabled",
      "slot": "root",
      "prop": "openDelay",
      "note": "마우스 — 키보드 초점은 바로(0). 하나가 열린 뒤 옆 트리거로 옮기면 바로 · 모션 없이"
    },
    {
      "rule": 1,
      "state": "enabled",
      "slot": "root",
      "prop": "closeDelay",
      "note": "트리거와 말풍선을 모두 벗어난 뒤 — 말풍선 위로 옮겨도 닫히지 않는다(WCAG 1.4.13)"
    },
    {
      "rule": 1,
      "state": "enabled",
      "slot": "root",
      "prop": "skipDelay",
      "note": "하나가 닫힌 뒤 이 시간 안에 옆 트리거로 옮기면 기다리지 않고 모션 없이 바로 연다"
    },
    {
      "rule": 2,
      "state": "enabled",
      "slot": "closeButton",
      "prop": "size",
      "note": "투명 상자 — 말풍선 오른쪽 위 모서리에 붙는다(위 0 · 오른쪽 0). 글과 이 상자 사이 4(SEED 와 같다)"
    },
    {
      "rule": 2,
      "state": "enabled",
      "slot": "closeButton",
      "prop": "touchTarget",
      "note": "사방 3 넓힌다(SEED 38)"
    },
    {
      "rule": 2,
      "state": "enabled",
      "slot": "closeButton",
      "prop": "iconSize",
      "note": "lucide x — 위 12 · 오른쪽 12 자리"
    },
    {
      "rule": 2,
      "state": "enabled",
      "slot": "closeButton",
      "prop": "radius",
      "note": "바탕이 없어 초점 링에만 보인다(SEED 와 같다)"
    },
    {
      "rule": 2,
      "state": "pressed",
      "slot": "closeButton",
      "prop": "scale",
      "note": "바탕 없이 아이콘만 — 모션 줄이기면 하지 않는다"
    }
  ]
}
