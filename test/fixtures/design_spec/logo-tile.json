{
  "name": "LogoTile",
  "source": "specs/components/logo-tile.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "9d344caf3f10"
  },
  "slots": {
    "root": "타일 — 정사각 · 모서리 크기 × 0.3. 기관 색 면 또는 이름 색 면",
    "initial": "첫 글자 — 이름의 첫 글자 하나(Avatar 규칙). 그림이 덮기 전 · 그림이 없을 때 · 실패했을 때",
    "plate": "그림 판 — 그림이 오면 첫 글자를 덮는다. 카드 그림은 옅은 판, 로고 그림은 흰 판",
    "image": "그림 — 카드 그림(카드 전체 — 세로는 돌린다) · 로고 그림(잘리지 않게)",
    "stroke": "안쪽 1px 윤곽 — 면 · 판 · 그림 위에 늘"
  },
  "axes": {
    "size": [
      "32",
      "40",
      "48"
    ],
    "face": [
      "institution",
      "name"
    ],
    "image": [
      "none",
      "card",
      "logo"
    ]
  },
  "defaults": {
    "size": "40",
    "face": "institution",
    "image": "none"
  },
  "states": [
    "enabled"
  ],
  "rules": [
    {
      "when": {},
      "enabled": {
        "root": {
          "overflow": "hidden"
        },
        "initial": {
          "fontWeight": 700,
          "lineHeight": 1,
          "textTransform": "uppercase"
        },
        "plate": {
          "padding": 4
        },
        "stroke": {
          "borderWidth": 1,
          "borderColor": {
            "light": "#0000000C",
            "dark": "#FFFFFF0D"
          }
        }
      }
    },
    {
      "when": {
        "size": "32"
      },
      "enabled": {
        "root": {
          "size": 32,
          "radius": 10
        },
        "initial": {
          "fontSize": 13
        }
      }
    },
    {
      "when": {
        "size": "40"
      },
      "enabled": {
        "root": {
          "size": 40,
          "radius": 12
        },
        "initial": {
          "fontSize": 16
        }
      }
    },
    {
      "when": {
        "size": "48"
      },
      "enabled": {
        "root": {
          "size": 48,
          "radius": 14
        },
        "initial": {
          "fontSize": 19
        }
      }
    },
    {
      "when": {
        "face": "institution"
      },
      "enabled": {
        "root": {
          "background": "기관 색"
        },
        "initial": {
          "foreground": "기관 글자색"
        }
      }
    },
    {
      "when": {
        "face": "name"
      },
      "enabled": {
        "root": {
          "background": "chart-{이름 색}"
        },
        "initial": {
          "foreground": {
            "light": "#FFFFFF",
            "dark": "#242938"
          }
        }
      }
    },
    {
      "when": {
        "image": "card"
      },
      "enabled": {
        "plate": {
          "background": {
            "light": "#F5F6FA",
            "dark": "#353B4D"
          }
        },
        "image": {
          "objectFit": "카드 전체",
          "radius": "Image Frame 모서리"
        }
      }
    },
    {
      "when": {
        "image": "logo"
      },
      "enabled": {
        "plate": {
          "background": "#FFFFFF"
        },
        "image": {
          "objectFit": "contain"
        }
      }
    }
  ],
  "notes": [
