    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "initial",
      "prop": "lineHeight",
      "note": "타일 가운데 — 글자 크기 설정을 따르지 않는 px(타일 안에서 넘치지 않게, Avatar 와 같다)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "initial",
