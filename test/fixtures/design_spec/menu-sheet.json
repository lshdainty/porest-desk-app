  "motion": {
    "열림 — 시트": {
      "duration": "300ms",
      "easing": "cubic-bezier(0.03, 0.4, 0.1, 1)",
      "properties": [
        "translateY 100% → 0"
      ],
      "note": "Bottom Sheet 와 같다 — 모션 줄이기면 150ms 서서히 나타남(v104)"
    },
    "열림 — 딤": {
      "duration": "300ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "opacity 0 → 1"
      ]
    },
    "닫힘 — 시트": {
      "duration": "200ms",
      "easing": "cubic-bezier(0.35, 0, 1, 1)",
      "properties": [
        "translateY → 100%"
      ]
