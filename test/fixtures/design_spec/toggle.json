{
  "name": "Toggle",
  "source": "specs/components/toggle.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "9d344caf3f10"
  },
  "slots": {
    "root": "ⓐ container — 채움 · 테두리 · 글자",
    "icon": "ⓑ 아이콘(선택)",
    "focusRing": "ⓓ 키보드 포커스 링"
  },
  "axes": {
    "variant": [
      "default",
      "outline"
    ],
    "size": [
      "sm",
      "default",
      "lg"
    ],
    "pressed": [
      "off",
      "on"
    ]
  },
  "defaults": {
    "variant": "default"
  },
  "states": [
    "enabled",
    "hover",
    "focus-visible",
    "disabled"
  ],
  "rules": [
    {
      "when": {},
      "enabled": {
        "root": {
          "typography": {
            "fontSize": 12,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 600
        },
        "icon": {
          "size": 16
        }
      },
      "focus-visible": {
        "focusRing": {
          "width": 2,
          "offset": 2,
          "color": {
            "light": "#0147AD",
            "dark": "#7AA9F6"
          }
        }
      },
      "disabled": {
        "root": {
          "opacity": 0.5,
          "pointerEvents": "none"
        }
      }
    },
    {
      "when": {
        "variant": "default"
      },
      "enabled": {
        "root": {
          "borderColor": "transparent"
        }
      }
    },
    {
      "when": {
        "variant": "outline"
      },
      "enabled": {
        "root": {
          "borderWidth": 1,
          "borderColor": {
            "light": "#E5E8EF",
            "dark": "#404757"
          }
        }
      }
    },
    {
      "when": {
        "size": "sm"
      },
      "enabled": {
        "root": {
          "paddingY": 4,
          "paddingX": 8,
          "minHeight": 28
        }
      }
    },
    {
      "when": {
        "size": "default"
      },
      "enabled": {
        "root": {
          "paddingY": 4,
          "paddingX": 12,
          "minHeight": 32
        }
      }
    },
    {
      "when": {
        "size": "lg"
      },
      "enabled": {
        "root": {
          "paddingY": 8,
          "paddingX": 16,
          "minHeight": 40
        }
      }
    },
    {
      "when": {
        "pressed": "off"
      },
      "enabled": {
        "root": {
          "background": "transparent",
          "foreground": {
            "light": "#535866",
            "dark": "#B7BDCC"
          }
        }
      },
      "hover": {
        "root": {
          "background": {
            "light": "#F5F6FA",
            "dark": "#353B4D"
          },
          "foreground": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          }
        }
      }
    },
    {
      "when": {
        "pressed": "on"
      },
      "enabled": {
        "root": {
          "background": {
            "light": "#F5F6FA",
            "dark": "#353B4D"
          },
          "foreground": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          }
        }
      }
    },
    {
      "when": {
        "variant": "outline",
        "pressed": "on"
      },
      "enabled": {
        "root": {
          "borderColor": {
            "light": "#767C8B",
            "dark": "#838997"
          }
        }
      }
    }
  ],
  "notes": [
    {
      "rule": 0,
      "state": "focus-visible",
      "slot": "focusRing",
      "prop": "color",
      "note": "`ring-2 ring-ring ring-offset-2` — ring = border-focus(shadcn bridge)"
    },
    {
      "rule": 0,
      "state": "disabled",
      "slot": "root",
      "prop": "pointerEvents",
      "note": "`pointer-events: none`"
    },
    {
      "rule": 1,
      "state": "enabled",
      "slot": "root",
      "prop": "borderColor",
      "note": "없음"
    }
  ]
}
