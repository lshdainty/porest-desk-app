{
  "name": "Navigation Menu",
  "source": "specs/components/navigation-menu.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "9d344caf3f10"
  },
  "slots": {
    "root": "Trigger / Link 상자 — ⓑ Trigger · ⓒ ⓓ ⓔ Link",
    "list": "Trigger 들을 담는 줄",
    "chevron": "ⓑ 의 ChevronDown",
    "icon": "ⓓ ⓔ 의 lucide 아이콘",
    "viewport": "ⓕ NavigationMenuContent / Viewport",
    "indicator": "ⓖ NavigationMenuIndicator 의 화살표",
    "cardLink": "ⓗ NavigationMenuLink (Viewport 내) — 카드",
    "cardTitle": "카드 title",
    "cardDesc": "카드 description",
    "focusRing": "키보드 포커스 링"
  },
  "axes": {
    "pattern": [
      "text-chevron",
      "text-only",
      "icon-only",
      "text-icon"
    ],
    "part": [
      "trigger",
      "cardLink"
    ]
  },
  "defaults": {},
  "states": [
    "default",
    "hover",
    "focus-visible",
    "open",
    "active",
    "disabled"
  ],
  "rules": [
    {
      "when": {},
      "default": {
        "root": {
          "height": 40,
          "radius": 4,
          "typography": {
            "fontSize": 15,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 500
        },
        "list": {
          "gap": 4
        },
        "chevron": {
          "size": 12
        },
        "viewport": {
          "marginTop": 4,
          "minWidth": "사용처 결정",
          "padding": 16,
          "radius": 8,
          "background": {
            "light": "#FFFFFF",
            "dark": "#242938"
          },
          "borderWidth": 1,
          "borderColor": {
            "light": "#E5E8EF",
            "dark": "#404757"
          },
          "shadow": {
            "light": "0 8px 24px -4px rgba(15, 18, 28, 0.10), 0 2px 6px -2px rgba(15, 18, 28, 0.05)",
            "dark": "0 8px 24px -4px rgba(0, 0, 0, 0.50), 0 2px 6px -2px rgba(0, 0, 0, 0.25), inset 0 1px 0 0 rgba(255, 255, 255, 0.08)"
          }
        },
        "indicator": {
          "size": 8,
          "radius": 4,
          "background": {
            "light": "#E5E8EF",
            "dark": "#404757"
          },
          "rotate": "45°"
        },
        "cardLink": {
          "padding": 12,
          "gap": 4,
          "background": "transparent"
        },
        "cardTitle": {
          "typography": {
            "fontSize": 16,
            "fontWeight": 500,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 500,
          "foreground": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          }
        },
        "cardDesc": {
          "typography": {
            "fontSize": 14,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "foreground": {
            "light": "#535866",
            "dark": "#B7BDCC"
          }
        }
      }
    },
    {
      "when": {
        "pattern": "text-chevron"
      },
      "default": {
        "root": {
          "paddingY": 8,
          "paddingX": 16
        }
      }
    },
    {
      "when": {
        "pattern": "text-only"
      },
      "default": {
        "root": {
          "paddingY": 8,
          "paddingX": 16
        }
      }
    },
    {
      "when": {
        "pattern": "icon-only"
      },
      "default": {
        "root": {
          "width": 40
        },
        "icon": {
          "size": 18
        }
      }
    },
    {
      "when": {
        "pattern": "text-icon"
      },
      "default": {
        "root": {
          "paddingX": 12,
          "gap": 4
        },
        "icon": {
          "size": 16
        }
      }
    },
    {
      "when": {
        "part": "trigger"
      },
      "default": {
        "root": {
          "background": {
            "light": "#FFFFFF",
            "dark": "#242938"
          },
          "foreground": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          }
        }
      },
      "hover": {
        "root": {
          "background": {
            "light": "#F5F6FA",
            "dark": "#353B4D"
          }
        }
      },
      "focus-visible": {
        "root": {
          "background": {
            "light": "#F5F6FA",
            "dark": "#353B4D"
          }
        },
        "focusRing": {
          "width": 2,
          "offset": 2,
          "color": {
            "light": "#0147AD",
            "dark": "#7AA9F6"
          }
        }
      },
      "open": {
        "root": {
          "background": {
            "light": "#F5F6FA80",
            "dark": "#353B4D80"
          }
        },
        "chevron": {
          "rotate": "180°"
        }
      },
      "active": {
        "root": {
          "background": {
            "light": "#F5F6FA80",
            "dark": "#353B4D80"
          }
        }
      },
      "disabled": {
        "root": {
          "background": "transparent",
          "opacity": 0.5,
          "cursor": "not-allowed"
        }
      }
    },
    {
      "when": {
        "part": "cardLink"
      },
      "hover": {
        "cardLink": {
          "background": {
            "light": "#F5F6FA",
            "dark": "#353B4D"
          }
        }
      },
      "focus-visible": {
        "cardLink": {
          "background": {
            "light": "#F5F6FA",
            "dark": "#353B4D"
          }
        },
        "focusRing": {
          "width": 2,
          "color": {
            "light": "#0147AD",
            "dark": "#7AA9F6"
          }
        }
      }
    }
  ],
  "motion": {
    "trigger": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
      "properties": [
        "colors"
      ]
    },
    "chevron": {
      "duration": "200ms",
      "properties": [
        "transform"
      ]
    }
  },
  "notes": [
    {
      "rule": 0,
      "state": "default",
      "slot": "list",
      "prop": "gap",
      "note": "`space-x-[var(--spacing-xs)]` (또는 flex gap)"
    },
    {
      "rule": 0,
      "state": "default",
      "slot": "viewport",
      "prop": "minWidth",
      "note": "`md:w-[400px]` 등"
    },
    {
      "rule": 0,
      "state": "default",
      "slot": "viewport",
      "prop": "padding",
      "note": "(사용처) — 또는 사용처 결정"
    },
    {
      "rule": 0,
      "state": "default",
      "slot": "viewport",
      "prop": "shadow",
      "note": "inline — `style={{ boxShadow: \"var(--shadow-lg)\" }}`"
    },
    {
      "rule": 0,
      "state": "default",
      "slot": "indicator",
      "prop": "radius",
      "note": "왼쪽 위만 — `rounded-tl-sm`"
    },
    {
      "rule": 0,
      "state": "default",
      "slot": "cardLink",
      "prop": "gap",
      "note": "title↔desc"
    },
    {
      "rule": 3,
      "state": "default",
      "slot": "root",
      "prop": "width",
      "note": "40×40 정사각 — Button icon size 정합"
    },
    {
      "rule": 3,
      "state": "default",
      "slot": "icon",
      "prop": "size",
      "note": "또는 lucide `size={18}`"
    },
    {
      "rule": 4,
      "state": "default",
      "slot": "root",
      "prop": "paddingX",
      "note": "값 칸은 `16 가변`"
    },
    {
      "rule": 5,
      "state": "default",
      "slot": "root",
      "prop": "background",
      "note": "또는 transparent"
    },
    {
      "rule": 5,
      "state": "focus-visible",
      "slot": "focusRing",
      "prop": "color",
      "note": "`ring-2 ring-ring ring-offset-2` — ring = border-focus(shadcn bridge)"
    },
    {
      "rule": 5,
      "state": "disabled",
      "slot": "root",
      "prop": "cursor",
      "note": "`cursor-not-allowed`"
    },
    {
      "rule": 6,
      "state": "hover",
      "slot": "cardLink",
      "prop": "background",
      "note": "시각 (변화 없음)"
    },
    {
      "rule": 6,
      "state": "focus-visible",
      "slot": "focusRing",
      "prop": "color",
      "note": "`ring-2 ring-ring` — ring = border-focus(shadcn bridge)"
    }
  ]
}
