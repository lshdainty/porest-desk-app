  "notes": [
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "touchTarget",
      "note": "보이는 크기와 따로 — 누르는 영역을 가로 · 세로 44 까지 넓힌다(v106). AA ✓ · AAA ✓"
    },
    {
      "rule": 0,
      "state": "pressed",
      "slot": "root",
      "prop": "scale",
      "note": "기준 길이 max(높이, 폭 ÷ 4, 24) 에서 2px — Feedback 의 눌림 피드백(v104)"
    },
    {
      "rule": 0,
      "state": "loading",
      "slot": "root",
      "prop": "press",
      "note": "누르기(포인터 · Enter · Space)를 삼켜 두 번 제출을 막는다 — 축소도 없다. aria-busy=true. SEED 는 막지 않는다"
    },
    {
      "rule": 0,
      "state": "loading",
      "slot": "label",
      "prop": "color",
      "note": "글자 · 아이콘을 투명하게 해 폭을 그대로 둔다"
    },
    {
      "rule": 0,
      "state": "disabled",
      "slot": "root",
      "prop": "cursor",
      "note": "포인터 이벤트는 켜 둔다 — 끄면 이 커서가 안 보인다(SEED 와 같다)"
    },
    {
      "rule": 5,
      "state": "enabled",
      "slot": "root",
      "prop": "borderColor",
      "note": "SEED stroke.neutral-muted(투명도 있는 검정)의 불투명 짝"
    },
    {
      "rule": 5,
      "state": "pressed",
      "slot": "root",
      "prop": "background",
      "note": "SEED bg.transparent-pressed 의 불투명 짝"
    },
    {
      "rule": 14,
      "state": "enabled",
      "slot": "root",
      "prop": "height",
      "note": "SEED 52 — porest 는 48(사용자 결정)"
    },
    {
      "rule": 21,
      "state": "enabled",
      "slot": "root",
      "prop": "paddingY",
      "note": "(48 − 줄 높이 24) ÷ 2 — SEED 52 는 14"
    }
  ]
