  "slots": {
    "root": "버튼 상자(Container) — 배경 · 테두리 · 모양, 글자 · 아이콘 색(currentColor)",
    "label": "글자(Label)",
    "prefixIcon": "앞 아이콘(Prefix Icon) — 동작의 뜻을 돕는다",
    "suffixIcon": "뒤 아이콘(Suffix Icon) — chevron 처럼 동작을 돕는다",
    "icon": "아이콘만 있는 버튼의 아이콘",
    "progressCircle": "로딩 원",
    "focusRing": "키보드 포커스 링(웹)"
  },
  "axes": {
    "variant": [
      "brandSolid",
      "neutralSolid",
      "neutralWeak",
      "criticalSolid",
      "brandOutline",
      "neutralOutline",
      "ghost"
    ],
    "size": [
      "xsmall",
      "small",
      "medium",
      "large"
    ],
    "layout": [
      "withText",
      "iconOnly"
    ],
    "ghostColor": [
      "neutral",
      "neutralSubtle",
      "brand",
      "critical"
    ]
  },
  "defaults": {
    "variant": "neutralSolid",
    "size": "medium",
    "layout": "withText",
    "ghostColor": "neutral"
  },
  "states": [
    "enabled",
    "hovered",
    "focused",
    "pressed",
    "loading",
    "disabled"
