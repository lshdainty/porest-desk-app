        "root": {
          "cursor": "pointer",
          "touchTarget": "44 × 44",
          "transitionProperty": "background-color, color",
          "transitionDuration": "150ms",
          "transitionEasing": "cubic-bezier(0.35, 0, 0.35, 1)"
        },
        "label": {
          "fontFamily": "Pretendard, Inter, sans-serif",
          "fontWeight": 700
        }
      },
      "pressed": {
        "root": {
          "scale": "세로 2px 축소",
          "scaleDuration": "150ms",
          "scaleEasing": "cubic-bezier(0, 0, 0.15, 1)"
        }
      },
      "focused": {
        "focusRing": {
          "width": 2,
          "offset": 2,
          "color": {
            "light": "#0147AD",
            "dark": "#7AA9F6"
          }
        }
      },
      "loading": {
        "root": {
          "cursor": "progress",
          "press": "막음"
        },
        "label": {
