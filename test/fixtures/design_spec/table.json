  "slots": {
    "root": "표 상자 — 카드 안에 가장자리까지 붙는다. 표와 넘김 줄(Table Pagination)을 담고, 넘치면 함께 가로로 민다",
    "caption": "표 이름 `<caption>` — 보이는 제목은 카드 머리, 여기는 같은 글을 숨겨 둔다",
    "headerRow": "머리 줄 `<thead><tr>` — 바탕 없음, 아래 선",
    "headerCell": "머리 칸 `<th scope=\"col\">` — 열 이름. ⋮ 열은 글 없이 숨긴 \"동작\"",
    "sortButton": "정렬 버튼 — 정렬할 수 있는 열의 머리 칸을 채운다",
    "sortIcon": "정렬 표시 ↑↓ — 정렬할 수 있는 열에 늘 있다",
    "row": "본문 줄 `<tr>` — 아래 선(마지막 줄까지)",
    "cell": "본문 칸 `<td>` — 첫 열(이름)은 `<th scope=\"row\">`",
    "detail": "칸의 둘째 줄 · 보조 글(ID · 부서 · 단위) — 옅은 글",
    "thumbnail": "칸 앞 그림 — Image Frame 1:1 48",
    "badge": "상태 칸 — Badge medium weak",
    "checkbox": "선택 칸 — Checkbox large 24(머리는 전체 · 일부)",
    "moreButton": "줄 끝 ⋮ — Button ghost iconOnly medium, 이름 \"{줄 이름} 더보기\"",
    "bulkBar": "일괄 작업 바 — 고른 줄이 있을 때만, 표 위",
    "focusRing": "키보드 포커스 링(웹)"
  },
  "axes": {
    "row": [
      "text",
      "rich"
    ],
    "align": [
      "start",
      "end"
    ],
    "sort": [
      "none",
      "sortable",
