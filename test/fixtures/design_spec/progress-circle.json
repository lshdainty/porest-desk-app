      ],
      "note": "머리와 겹쳐 호가 늘었다 줄며 돈다"
    },
    "채움": {
      "duration": "300ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "stroke-dashoffset"
      ],
      "note": "값 있는 원 — 값이 바뀔 때. 처음 그릴 때는 움직이지 않는다. 모션 줄이기면 바로"
    }
  },
