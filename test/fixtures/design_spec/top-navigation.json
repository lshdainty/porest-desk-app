  "slots": {
    "root": "바 — 화면 폭 · 높이 56(위 안전 영역은 더한다). 맨 위에 붙어 스크롤해도 그 자리에 있다",
    "leading": "왼쪽 자리 — standard 만. 아이콘 버튼 하나(← · ✕ · ☰)",
    "title": "제목 — 화면 이름 한 줄(h1). 넘치면 말줄임",
    "trailing": "오른쪽 자리 — 아이콘 버튼 2개 권장 · 3개까지, 또는 글 버튼 하나. 넘치면 ⋯ 하나로 모은다",
    "iconButton": "아이콘 버튼 — 상자 44 가 곧 누르는 영역, 아이콘 24, 버튼끼리 붙는다. 이름은 aria-label",
    "textButton": "글 버튼 — 오른쪽 자리에 하나만(\"완료\" · \"모두 읽음\")",
    "notification": "알림 점 — 벨 아이콘의 오른쪽 위(Notification Badge small). 숫자는 두지 않는다",
    "primaryButton": "주 버튼 — desktop 만. Button brandSolid small 하나(\"내역 추가\")",
    "focusRing": "키보드 포커스 링(웹) — 버튼 상자 안쪽"
  },
  "axes": {
    "type": [
      "root",
      "standard",
      "desktop"
    ],
    "leadingIcon": [
      "back",
      "close",
      "menu"
    ]
  },
  "defaults": {
    "type": "standard",
    "leadingIcon": "back"
  },
  "states": [
    "enabled",
    "hovered",
    "pressed",
    "focused",
    "disabled"
  ],
