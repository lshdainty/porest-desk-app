      "enabled": {
        "chevron": {
          "rotate": "180deg"
        },
        "panel": {
          "display": "보임"
        }
      }
    },
    {
      "when": {
        "description": "shown"
      },
      "enabled": {
        "trigger": {
          "minHeight": 74
        }
      }
    },
    {
      "when": {
        "detail": "none"
      },
      "enabled": {
        "heading": {
          "level": "없음"
        },
        "trigger": {
          "cursor": "default",
          "touchTarget": "없음"
        },
        "chevron": {
          "display": "none"
        }
      },
      "hovered": {
        "background": {
          "background": "transparent",
          "insetX": 0,
          "radius": 0
