  "motion": {
    "펼침 · 접힘 — 높이": {
      "duration": "300ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "height"
      ],
      "note": "SEED expandHeight · collapseHeight d6 · easing(사용자 결정 3A). 펼칠 때 저절로 스크롤하지 않는다"
    },
    "꺾쇠 — 회전": {
      "duration": "300ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "rotate"
      ],
      "note": "0 → 180° — 높이와 같은 시간. 모션 줄이기면 바로 뒤집힌다"
    },
    "모션 줄이기 — 펼침 · 접힘": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "opacity"
      ],
      "note": "높이를 움직이지 않고 내용이 150ms 서서히 나타나고 사라진다(v104 — 200ms 넘는 움직임은 150ms 서서히)"
    },
    "누름 · 호버 — 바탕": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "background-color",
        "inset",
        "border-radius"
      ],
      "note": "바탕이 좌우 6 들어오며 모서리 10 으로 둥글어진다 — 모두 펼치기 단추의 바탕도 같은 시간"
    },
    "누름 — 콘텐츠": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "scale"
      ],
      "note": "콘텐츠 층만 2px 거리 축소 — 모션 줄이기면 하지 않는다"
    }
  },
