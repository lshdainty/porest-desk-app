      "enabled": {
        "root": {
          "gap": 8
        },
        "item": {
          "borderWidth": 1,
          "borderColor": {
            "light": "#E5E8EF",
            "dark": "#404757"
          },
          "radius": 16,
          "shadow": "none",
          "overflow": "hidden"
        }
      },
      "focused": {
        "focusRing": {
          "radius": 14
        }
      }
    },
    {
      "when": {
        "open": "expanded"
