          "right": 24,
          "touchTarget": "52 × 52",
          "transitionProperty": "background-color, scale",
          "transitionDuration": "150ms",
          "transitionEasing": "cubic-bezier(0.35, 0, 0.35, 1)"
        },
        "divider": {
          "height": 1,
          "background": {
            "light": "#EDEFF3",
            "dark": "#353B4D"
          },
          "transitionDuration": "150ms",
          "transitionEasing": "cubic-bezier(0.35, 0, 0.35, 1)"
        },
        "body": {
          "paddingX": 24,
          "paddingBottom": 24,
          "overflowY": "auto"
        },
        "footer": {
          "paddingTop": 16,
          "paddingX": 24,
          "paddingBottom": 24,
          "gap": 8,
          "justifyContent": "flex-end",
          "buttonSize": "small 36"
        }
      },
      "scrolled": {
        "divider": {
          "opacity": 1
        }
      },
      "pressed": {
        "closeButton": {
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          },
          "scale": "2px 거리 축소"
        }
      },
      "focused": {
        "focusRing": {
          "width": 2,
          "offset": 2,
          "color": {
            "light": "#0147AD",
            "dark": "#7AA9F6"
          }
        }
      }
    },
    {
      "when": {
        "side": "right"
      },
      "enabled": {
        "root": {
          "position": "오른쪽 끝"
        }
      }
    },
    {
      "when": {
        "size": "small"
      },
      "enabled": {
        "root": {
          "width": 480
        }
      }
    },
    {
      "when": {
        "size": "medium"
      },
      "enabled": {
        "root": {
          "width": 720
        }
      }
    },
    {
      "when": {
        "size": "large"
      },
      "enabled": {
        "root": {
          "width": 960
        }
      }
    },
    {
      "when": {
        "side": "left"
      },
      "enabled": {
        "root": {
          "width": "화면 폭의 80%",
          "position": "왼쪽 끝"
        },
        "title": {
          "typography": {
            "fontSize": 22,
            "lineHeight": 30,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          }
        },
        "body": {
          "paddingX": 16
        }
      }
    },
    {
      "when": {
        "scrollFog": "on"
      },
      "enabled": {
        "fog": {
          "mask": "linear-gradient(#00000000 0%, #00000003 8%, #00000005 16%, #0000000d 22%, #00000014 29%, #00000021 35%, #0000002e 41%, #00000040 47%, #00000052 53%, #00000066 59%, #0000007a 65%, #00000094 71%, #000000ab 78%, #000000c7 84%, #000000e3 92%, #000000ff 100%)",
          "size": "위 20px · 아래 80px"
        },
        "body": {
          "paddingTop": 20,
          "paddingBottom": 80,
          "scrollPadding": "위 20px · 아래 80px"
        }
      }
    }
