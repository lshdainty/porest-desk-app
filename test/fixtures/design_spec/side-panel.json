  },
  "slots": {
    "overlay": "딤 — 패널 뒤 화면 전체. 입력 폼이 아니면 누르면 닫힌다",
    "root": "패널 — 화면 높이 전체, 왼쪽 또는 오른쪽 끝에 붙는다. 모서리 · 그림자 · 선 없음",
    "header": "머리 — 제목 · 설명 · 닫기",
    "title": "제목 — 늘 있다(패널의 이름)",
    "description": "설명 — 덧붙일 말이 있을 때만",
    "closeButton": "닫기 — 투명 상자 52 · 아이콘 22. 이름 \"닫기\"",
    "divider": "머리 아래 선 — 본문이 스크롤됐을 때만",
    "body": "본문 — 넘치면 이 안에서만 스크롤(머리 · 바닥은 고정)",
    "fog": "끝 흐림 — Scroll Fog(scroll-fog.yaml 의 overlayBody). 넘칠 수 있는 본문에만 걸고, 걸면 늘 켜져 있다",
    "footer": "바닥 — 버튼, 오른쪽 정렬(오른쪽 패널)",
    "focusRing": "키보드 포커스 링(웹)"
  },
  "axes": {
    "side": [
      "left",
      "right"
    ],
    "size": [
      "small",
      "medium",
      "large"
    ],
    "scrollFog": [
      "off",
      "on"
    ]
  },
  "defaults": {
    "side": "right",
    "size": "medium",
    "scrollFog": "off"
  },
  "states": [
    "enabled",
    "scrolled",
    "pressed",
    "focused"
  ],
  "rules": [
    {
      "when": {},
