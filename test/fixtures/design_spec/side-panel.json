        "overlay": {
          "background": {
            "light": "rgba(0, 0, 0, 0.50)",
            "dark": "rgba(0, 0, 0, 0.65)"
          },
          "zIndex": 100
        },
        "root": {
          "height": "화면 높이 전체",
          "maxWidth": "80%",
          "radius": 0,
          "background": {
            "light": "#FFFFFF",
            "dark": "#2D3346"
          },
          "shadow": "none",
          "paddingBottom": "아래 안전 영역",
          "zIndex": 101
        },
        "header": {
          "paddingTop": 24,
          "paddingX": 24,
          "paddingBottom": 16,
          "minHeight": 70,
          "gap": 6
        },
        "title": {
          "typography": {
            "fontSize": 22,
            "lineHeight": 30,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 700,
          "foreground": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          }
        },
        "description": {
          "typography": {
            "fontSize": 16,
            "lineHeight": 22,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 400,
          "foreground": {
            "light": "#535866",
            "dark": "#B7BDCC"
          }
        },
        "closeButton": {
          "size": 52,
          "radius": 12,
          "iconSize": 22,
          "color": {
            "light": "#62697A",
            "dark": "#A2A8B7"
