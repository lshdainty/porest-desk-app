  "motion": {
    "열림 — 패널": {
      "duration": "300ms",
      "easing": "cubic-bezier(0.03, 0.4, 0.1, 1)",
      "properties": [
        "translateX ∓100% → 0"
      ],
      "note": "붙은 쪽에서 미끄러져 들어온다(SEED). 모션 줄이기면 150ms 서서히 나타남(v104)"
    },
    "열림 — 딤": {
      "duration": "300ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "opacity 0 → 1"
      ]
    },
    "닫힘 — 패널": {
      "duration": "300ms",
      "easing": "cubic-bezier(0.35, 0, 0.95, 0.55)",
      "properties": [
        "translateX → ∓100%"
      ],
      "note": "끌다 놓아 되돌아갈 때도 같은 시간"
    },
    "닫힘 — 딤": {
      "duration": "300ms",
      "easing": "cubic-bezier(0.35, 0, 1, 1)",
      "properties": [
        "opacity → 0"
      ]
    },
    "머리 아래 선": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "box-shadow"
      ]
    },
    "누름 — 닫기 버튼": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "scale"
      ]
    }
  },
