{
  "name": "Textarea",
  "source": "specs/components/textarea.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "9d344caf3f10"
  },
  "slots": {
    "root": "상자(Container) — 테두리 · 바탕 · 모서리. 넘치는 글은 상자 안에서 잘린다(모서리 밖으로 나가지 않는다)",
    "value": "입력(<textarea>) — 여백 · 높이를 가진다. 손으로 크기를 바꾸지 않는다(자동 높이가 대신한다)",
    "placeholder": "빈 칸의 예시 글 — 칸 이름 대신 쓰지 않는다"
  },
  "axes": {
    "size": [
      "large",
      "medium",
      "responsive"
    ],
    "autoSize": [
      "on",
      "off"
    ]
  },
  "defaults": {
    "size": "responsive",
    "autoSize": "on"
  },
  "states": [
    "enabled",
    "focused",
    "invalid",
    "disabled",
    "readonly"
  ],
  "rules": [
    {
      "when": {},
      "enabled": {
        "root": {
          "background": "transparent",
          "borderColor": {
            "light": "#E5E8EF",
            "dark": "#404757"
          },
          "borderWidth": 1,
          "cursor": "text",
          "transitionProperty": "border-color",
          "transitionDuration": "100ms",
          "transitionEasing": "cubic-bezier(0.35, 0, 0.35, 1)"
        },
        "value": {
          "foreground": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          },
          "fontWeight": 400,
          "resize": "none"
        },
        "placeholder": {
          "foreground": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          },
          "fontWeight": 400
        }
      },
      "focused": {
        "root": {
          "borderColor": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          },
          "borderWidth": 2
        }
      },
      "invalid": {
        "root": {
          "borderColor": {
            "light": "#D72323",
            "dark": "#FF8477"
          },
          "borderWidth": 2
        }
      },
      "disabled": {
        "root": {
          "background": {
            "light": "#F5F6FA",
            "dark": "#353B4D"
          },
          "cursor": "not-allowed"
        },
        "value": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "placeholder": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        }
      },
      "readonly": {
        "root": {
          "background": {
            "light": "#F5F6FA",
            "dark": "#353B4D"
          }
        }
      }
    },
    {
      "when": {
        "size": "large"
      },
      "enabled": {
        "root": {
          "radius": 12
        },
        "value": {
          "paddingX": 16,
          "paddingY": 14,
          "typography": {
            "fontSize": 16,
            "lineHeight": 22,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          }
        },
        "placeholder": {
          "typography": {
            "fontSize": 16,
            "lineHeight": 22,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          }
        }
      }
    },
    {
      "when": {
        "size": "medium"
      },
      "enabled": {
        "root": {
          "radius": 8
        },
        "value": {
          "paddingX": 14,
          "paddingY": 12,
          "typography": {
            "fontSize": 14,
            "lineHeight": 19,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          }
        },
        "placeholder": {
          "typography": {
            "fontSize": 14,
            "lineHeight": 19,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          }
        }
      }
    },
    {
      "when": {
        "size": "responsive"
      },
      "enabled": {
        "root": {
          "breakpoint": 1280
        }
      }
    },
    {
      "when": {
        "autoSize": "on",
        "size": "large"
      },
      "enabled": {
        "value": {
          "minHeight": 94,
          "maxHeight": "자리마다"
        }
      }
    },
    {
      "when": {
        "autoSize": "on",
        "size": "medium"
      },
      "enabled": {
        "value": {
          "minHeight": 82,
          "maxHeight": "자리마다"
        }
      }
    },
    {
      "when": {
        "autoSize": "off",
        "size": "large"
      },
      "enabled": {
        "value": {
          "minHeight": 72
        }
      }
    },
    {
      "when": {
        "autoSize": "off",
        "size": "medium"
      },
      "enabled": {
        "value": {
          "minHeight": 62
        }
      }
    }
  ],
  "motion": {
    "포커스 · 오류 — 테두리": {
      "duration": "100ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "border-color"
      ],
      "note": "안쪽에 덧그린 2px 의 색이 나타나고 사라진다. 높이가 자랄 때는 움직임을 주지 않는다(글이 바로 보이게)"
    }
  },
  "notes": [
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "borderWidth",
      "note": "상자 안쪽에 그린다(inset)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "transitionProperty",
      "note": "덧그린 2px 의 색만 — 두께는 바로 바뀐다(SEED)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "transitionDuration",
      "note": "SEED 는 0.1s 를 바로 적었다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "value",
      "prop": "resize",
      "note": "손잡이를 두지 않는다 — 자동 높이가 대신한다"
    },
    {
      "rule": 0,
      "state": "focused",
      "slot": "root",
      "prop": "borderColor",
      "note": "읽기 전용이면 바뀌지 않는다"
    },
    {
      "rule": 0,
      "state": "focused",
      "slot": "root",
      "prop": "borderWidth",
      "note": "안쪽에 덧그린다 — 글이 밀리지 않는다"
    },
    {
      "rule": 0,
      "state": "invalid",
      "slot": "root",
      "prop": "borderColor",
      "note": "포커스해도 그대로"
    },
    {
      "rule": 0,
      "state": "disabled",
      "slot": "root",
      "prop": "background",
      "note": "흐리게 하지 않는다(v106)"
    },
    {
      "rule": 0,
      "state": "readonly",
      "slot": "root",
      "prop": "background",
      "note": "값은 진한 글자 그대로 — 바탕만으로 편집 칸과 가른다"
    },
    {
      "rule": 3,
      "state": "enabled",
      "slot": "root",
      "prop": "breakpoint",
      "note": "미만은 large, 이상은 medium 의 값을 쓴다(SEED lg) — 앱은 늘 large"
    },
    {
      "rule": 4,
      "state": "enabled",
      "slot": "value",
      "prop": "minHeight",
      "note": "3줄 — 줄 높이 22 × 3 + 위아래 14"
    },
    {
      "rule": 4,
      "state": "enabled",
      "slot": "value",
      "prop": "maxHeight",
      "note": "정하지 않으면 끝없이 자란다. 정하면 그 높이부터 칸 안에서 스크롤"
    },
    {
      "rule": 5,
      "state": "enabled",
      "slot": "value",
      "prop": "minHeight",
      "note": "3줄 — 줄 높이 19 × 3 + 위아래 12 는 81, SEED 는 82"
    },
    {
      "rule": 5,
      "state": "enabled",
      "slot": "value",
      "prop": "maxHeight",
      "note": "정하지 않으면 끝없이 자란다. 정하면 그 높이부터 칸 안에서 스크롤"
    },
    {
      "rule": 6,
      "state": "enabled",
      "slot": "value",
      "prop": "minHeight",
      "note": "2줄 — 이보다 낮게 두지 않는다(SEED 문서 70). 높이는 자리마다 정하고, 넘치면 칸 안에서 스크롤"
    },
    {
      "rule": 7,
      "state": "enabled",
      "slot": "value",
      "prop": "minHeight",
      "note": "2줄 — 줄 높이 19 × 2 + 위아래 12. 높이는 자리마다 정하고, 넘치면 칸 안에서 스크롤"
    }
  ]
}
