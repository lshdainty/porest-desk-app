{
  "name": "Input",
  "source": "specs/components/input.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "9d344caf3f10"
  },
  "slots": {
    "root": "상자(Container) — 테두리 · 바탕 · 모서리. 어디를 눌러도 입력으로 포커스가 간다",
    "value": "입력(<input>) — 상자 높이를 채운다. 맨 앞 · 맨 뒤면 상자의 좌우 여백까지 차지한다",
    "placeholder": "빈 칸의 예시 글 — 칸 이름 대신 쓰지 않는다",
    "prefixIcon": "앞 아이콘 — 검색 돋보기처럼 칸의 뜻을 돕는다",
    "prefixText": "앞 글자 — https:// · 만 · − 같은 고정 글",
    "suffixText": "뒤 글자 — 단위(원 · % · 일 · 회 · cm)",
    "suffixIcon": "뒤 아이콘",
    "clearButton": "지우기 버튼 — 값이 있고 막히지 않았을 때만. 검색칸 · 선택 사항인 칸에 둔다"
  },
  "axes": {
    "variant": [
      "outline",
      "underline"
    ],
    "size": [
      "large",
      "medium",
      "responsive"
    ]
  },
  "defaults": {
    "variant": "outline",
    "size": "responsive"
  },
  "states": [
    "enabled",
    "focused",
    "invalid",
    "disabled",
    "readonly"
  ],
