  "motion": {
    "포커스 · 오류 — 테두리": {
      "duration": "100ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "border-color"
      ],
      "note": "안쪽에 덧그린 2px 의 색이 나타나고 사라진다. SEED 는 0.1s — porest d2 = 100ms"
    }
  },
  "notes": [
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "transitionProperty",
      "note": "덧그린 2px 의 색만 — 두께는 바로 바뀐다(SEED)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "transitionDuration",
      "note": "SEED 는 0.1s 를 바로 적었다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "clearButton",
      "prop": "color",
      "note": "lucide circle-x. 이름 \"지우기\" — 누르면 값을 비우고 입력에 포커스를 둔다"
    },
    {
      "rule": 0,
      "state": "focused",
      "slot": "root",
      "prop": "borderColor",
      "note": "읽기 전용이면 바뀌지 않는다"
    },
    {
      "rule": 0,
      "state": "invalid",
      "slot": "root",
      "prop": "borderColor",
      "note": "포커스해도 그대로"
    },
    {
      "rule": 1,
      "state": "enabled",
      "slot": "root",
      "prop": "borderWidth",
      "note": "상자 안쪽에 그린다(inset)"
    },
    {
      "rule": 1,
      "state": "focused",
      "slot": "root",
      "prop": "borderWidth",
      "note": "안쪽에 덧그린다 — 내용이 밀리지 않는다"
    },
    {
      "rule": 1,
      "state": "disabled",
      "slot": "root",
      "prop": "background",
      "note": "흐리게 하지 않는다(v106)"
    },
    {
      "rule": 1,
      "state": "readonly",
      "slot": "root",
      "prop": "background",
      "note": "값은 진한 글자 그대로 — 바탕만으로 편집 칸과 가른다"
    },
    {
      "rule": 2,
      "state": "enabled",
      "slot": "root",
      "prop": "borderBottomWidth",
      "note": "아래만 — 모서리 · 좌우 여백 없음"
    },
    {
      "rule": 2,
      "state": "readonly",
      "slot": "value",
      "prop": "foreground",
      "note": "바탕이 없어 글자로 가른다"
    },
    {
      "rule": 7,
      "state": "enabled",
      "slot": "root",
      "prop": "breakpoint",
      "note": "미만은 large, 이상은 medium 의 값을 쓴다(SEED lg) — 앱은 늘 large"
    }
