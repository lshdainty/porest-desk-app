  "motion": {
    "선택 안 됨 ↔ 선택 ↔ 일부 선택": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "background",
        "border",
        "icon color"
      ],
      "note": "칸의 채움 · 테두리 · 아이콘 색이 함께 바뀐다(SEED Checkmark 와 같다) — 아이콘은 커지거나 줄지 않는다"
    },
    "누름": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "scale"
      ],
      "note": "칸만 세로 2px 거리 축소 — 라벨은 줄지 않는다(v104)"
    }
  },
  "notes": [
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "alignSelf",
      "note": "줄은 칸 + 라벨만큼만 차지한다 — 묶음 폭으로 늘이지 않는다(직접 짠 줄은 묶음 폭을 쓴다)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "touchTarget",
      "note": "라벨까지 묶어 44 — 목록 행에서 칸만 쓰면 줄 전체가 누르는 영역(SEED touch target · 기초 Inclusive)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "icon",
      "prop": "glyph",
      "note": "lucide `Check` · 선 3"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "group",
      "prop": "gap",
      "note": "묶음 안 줄 사이(세로) — 줄 32 · 36 에 12 를 더해 44 · 48 마다 한 줄이라 이웃 줄과 누르는 영역(44)이 겹치지 않는다(사용자 결정 — SEED 는 4)"
    },
    {
      "rule": 0,
      "state": "pressed",
      "slot": "checkmark",
      "prop": "scale",
      "note": "칸만 준다 — 기준 길이 max(높이, 폭 ÷ 4, 24) 에서 2px(Feedback 의 눌림 피드백, v104)"
    },
    {
      "rule": 0,
      "state": "disabled",
      "slot": "root",
      "prop": "cursor",
      "note": "포인터 이벤트는 켜 둔다 — 끄면 이 커서가 안 보인다(SEED 와 같다)"
    },
    {
      "rule": 9,
      "state": "enabled",
      "slot": "checkmark",
      "prop": "borderColor",
      "note": "3:1 이상 — v109(SEED 는 옅은 선)"
    },
    {
      "rule": 9,
      "state": "enabled",
      "slot": "icon",
      "prop": "glyph",
      "note": "선택 안 된 칸에는 아이콘이 없다"
    },
    {
      "rule": 9,
      "state": "pressed",
      "slot": "checkmark",
      "prop": "background",
      "note": "SEED bg.transparent-pressed 의 불투명 짝"
    },
    {
      "rule": 9,
      "state": "disabled",
      "slot": "checkmark",
      "prop": "borderColor",
      "note": "SEED stroke.neutral-muted 의 불투명 짝"
    },
    {
      "rule": 11,
      "state": "enabled",
      "slot": "icon",
      "prop": "glyph",
      "note": "lucide `Minus` · 선 3"
    },
    {
      "rule": 16,
      "state": "enabled",
      "slot": "icon",
      "prop": "color",
      "note": "선택 안 됨도 옅은 체크로 보인다"
    },
    {
      "rule": 17,
      "state": "enabled",
      "slot": "icon",
      "prop": "glyph",
      "note": "lucide `Minus` · 선 3"
    },
    {
      "rule": 18,
      "state": "pressed",
      "slot": "checkmark",
      "prop": "background",
      "note": "SEED palette.gray-200"
    },
    {
      "rule": 20,
      "state": "pressed",
      "slot": "checkmark",
      "prop": "background",
      "note": "SEED palette.carrot-200 자리 — 브랜드 200"
    }
