{
  "name": "Checkbox",
  "source": "specs/components/checkbox.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "9d344caf3f10"
  },
  "slots": {
    "root": "Checkbox 한 줄 — 칸 + 라벨, 누르는 영역",
    "checkmark": "칸(Checkmark) — 배경 · 테두리 · 모양. 목록 행에는 이것만 넣어 쓴다",
    "icon": "체크 · 가로줄(lucide `Check` · `Minus`)",
    "label": "글자(Label)",
    "focusRing": "키보드 포커스 링(웹)",
    "group": "묶음(Checkbox Group) — 세로로 쌓는다"
  },
  "axes": {
    "size": [
      "medium",
      "large"
    ],
    "shape": [
      "square",
      "ghost"
    ],
    "tone": [
      "neutral",
      "brand"
    ],
    "weight": [
      "regular",
      "bold"
    ],
    "checked": [
      "unchecked",
      "checked",
      "indeterminate"
    ]
  },
  "defaults": {
    "size": "medium",
    "shape": "square",
    "tone": "neutral",
    "weight": "regular",
    "checked": "unchecked"
  },
  "states": [
    "enabled",
    "hovered",
    "focused",
    "pressed",
    "disabled"
  ],
  "rules": [
    {
      "when": {},
      "enabled": {
        "root": {
          "gap": 8,
          "cursor": "pointer",
          "alignSelf": "flex-start",
          "touchTarget": "44 × 44"
        },
        "checkmark": {
          "radius": 4,
          "transitionProperty": "background-color, border-color, color",
          "transitionDuration": "150ms",
          "transitionEasing": "cubic-bezier(0.35, 0, 0.35, 1)"
        },
        "icon": {
          "glyph": "Check"
        },
        "label": {
          "fontFamily": "Pretendard, Inter, sans-serif",
          "foreground": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          }
        },
        "group": {
          "gap": 12
        }
      },
      "pressed": {
        "checkmark": {
          "scale": "세로 2px 축소",
          "scaleDuration": "150ms",
          "scaleEasing": "cubic-bezier(0, 0, 0.15, 1)"
        }
      },
      "focused": {
        "focusRing": {
          "width": 2,
          "offset": 2,
          "color": {
            "light": "#0147AD",
            "dark": "#7AA9F6"
          }
        }
      },
      "disabled": {
        "root": {
          "cursor": "not-allowed"
        },
        "label": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        }
      }
    },
    {
