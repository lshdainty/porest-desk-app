          }
        }
      }
    },
    {
      "when": {
        "palette": "yellow"
      },
      "enabled": {
        "series": {
          "color": {
            "light": "#8C7400",
            "dark": "#C5A721"
          }
        }
      }
    },
    {
      "when": {
        "palette": "brown"
      },
      "enabled": {
        "series": {
          "color": {
            "light": "#9A6536",
            "dark": "#CF9F77"
          }
        }
      }
    },
    {
      "when": {
