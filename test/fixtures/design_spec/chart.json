{
  "name": "Chart",
  "source": "specs/components/chart.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "d0ae84eb0c4d"
  },
  "slots": {
    "root": "차트 상자 — 카드 본문 안, 폭 100%. 높이는 쓰는 자리가 정한다",
    "tickLabel": "눈금 글자 — 가로축(날짜 · 기간) · 세로축(값)",
    "gridLine": "가로 격자 — 점선, 세로 격자 · 축 선은 두지 않는다",
    "series": "계열 — 선 · 막대 · 조각 · 칸의 색",
    "line": "선 — 선 · 영역 차트",
    "bar": "막대",
    "point": "가리킨 점 — 가리킨 자리에만",
    "crosshair": "가리킴 선 — 세로 점선",
    "tooltip": "툴팁 — 떠 있는 표면",
    "tooltipHead": "툴팁 머리 — 날짜 · 기간, 옅은 작은 글",
    "tooltipRow": "툴팁 줄 — \"■ 라벨 값\"",
    "swatch": "색 네모 — 툴팁 · 도넛 범례의 계열 표시",
    "legendTile": "지표 타일 — 선 · 막대 차트 위. 범례 겸 합계, 누르면 계열을 켜고 끈다",
    "legendList": "도넛 범례 — 카테고리 목록 줄(색 네모 + 이름 + % + 금액)",
    "donutCenter": "도넛 가운데 — 합계",
    "heatmapCell": "열지도 칸 — 정사각형, 세기 색",
    "heatmapValue": "열지도 칸의 금액 — 칸 폭 112 이상에서만, 글자색이 칸 밝기를 따른다",
    "focusRing": "키보드 포커스 링(웹)"
  },
  "axes": {
    "kind": [
      "line",
      "bar",
      "donut",
      "heatmap"
    ],
    "axis": [
      "single",
      "dual"
    ],
    "legend": [
      "shown",
      "hidden"
    ],
    "palette": [
      "blue",
      "green",
      "orange",
      "violet",
      "pink",
      "indigo",
      "red",
      "yellow",
      "brown",
      "gray"
    ]
  },
  "defaults": {
    "kind": "line",
    "axis": "single",
    "legend": "shown"
  },
  "states": [
    "enabled",
    "hovered",
    "pressed",
    "focused",
    "disabled"
  ],
  "rules": [
    {
      "when": {},
      "enabled": {
        "root": {
          "width": "100%",
          "background": "transparent",
          "height": "쓰는 자리가 정한다"
        },
        "tickLabel": {
          "typography": {
            "fontSize": 11,
            "lineHeight": 15,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "foreground": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          },
          "numerals": "tabular-nums"
        },
        "gridLine": {
          "borderWidth": 1,
          "borderStyle": "dashed",
          "borderColor": {
            "light": "#EDEFF3",
            "dark": "#353B4D"
          }
        },
        "series": {
          "color": "chart-{색}"
        },
        "point": {
          "size": 10
        },
        "crosshair": {
          "borderWidth": 1,
          "borderStyle": "dashed",
          "borderColor": {
            "light": "#E5E8EF",
            "dark": "#404757"
          }
        },
        "tooltip": {
          "minWidth": 128,
          "paddingY": 10,
          "paddingX": 12,
          "radius": 12,
          "background": {
            "light": "#FFFFFF",
            "dark": "#2D3346"
          },
          "shadow": {
            "light": "0 8px 24px -4px rgba(15, 18, 28, 0.10), 0 2px 6px -2px rgba(15, 18, 28, 0.05)",
            "dark": "0 8px 24px -4px rgba(0, 0, 0, 0.50), 0 2px 6px -2px rgba(0, 0, 0, 0.25), inset 0 1px 0 0 rgba(255, 255, 255, 0.08)"
          },
          "gap": 4,
          "zIndex": 200
        },
        "tooltipHead": {
          "typography": {
            "fontSize": 12,
            "lineHeight": 16,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "foreground": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          }
        },
        "tooltipRow": {
          "typography": {
            "fontSize": 13,
            "lineHeight": 18,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "foreground": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          },
          "gap": 6
        },
        "swatch": {
          "size": 8,
          "radius": 2
        },
        "legendTile": {
          "radius": 12,
          "paddingY": 10,
          "paddingX": 12,
          "gap": 8,
          "typography": {
            "fontSize": 13,
            "lineHeight": 18,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "foreground": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          },
          "cursor": "pointer",
          "touchTarget": "타일 전체",
          "transitionProperty": "background-color, scale",
          "transitionDuration": "150ms",
          "transitionEasing": "cubic-bezier(0.35, 0, 0.35, 1)"
        },
        "legendList": {
          "minHeight": 44,
          "typography": {
            "fontSize": 14,
            "lineHeight": 19,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "gap": 8
        },
        "donutCenter": {
          "typography": {
            "fontSize": 16,
            "lineHeight": 22,
            "fontWeight": 700,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 700,
          "foreground": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          },
          "numerals": "tabular-nums"
        },
        "heatmapCell": {
          "aspectRatio": "1 / 1",
          "radius": 4,
          "background": "bg-brand-solid 18 · 35 · 55 · 76 · 100%"
        },
        "heatmapValue": {
          "threshold": 112,
          "typography": {
            "fontSize": 11,
            "lineHeight": 15,
            "fontWeight": 700,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 700,
          "numerals": "tabular-nums",
          "foreground": "단계마다"
        }
      },
      "hovered": {
        "legendList": {
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          }
        }
      },
      "pressed": {
        "legendTile": {
          "scale": "2px 거리 축소",
          "scaleDuration": "150ms",
          "scaleEasing": "cubic-bezier(0, 0, 0.15, 1)"
        },
        "legendList": {
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          }
        }
      },
      "focused": {
        "focusRing": {
          "width": 2,
          "offset": 2,
          "color": {
            "light": "#0147AD",
            "dark": "#7AA9F6"
          }
        }
      }
    },
    {
      "when": {
        "kind": "line"
      },
      "enabled": {
        "line": {
          "strokeWidth": 2
        }
      }
    },
    {
      "when": {
        "kind": "bar"
      },
      "enabled": {
        "bar": {
          "maxWidth": 28,
          "radius": 4,
          "gap": 4
        }
      }
    },
    {
      "when": {
        "kind": "donut"
      },
      "enabled": {
        "series": {
          "diameter": 160,
          "diameterPhone": 120,
          "thickness": "지름 ÷ 10 + 6",
          "thicknessPerDiameter": 0.1,
          "thicknessOffset": 6
        }
      }
    },
    {
      "when": {
        "kind": "heatmap"
      },
      "enabled": {
        "heatmapCell": {
          "gap": 6
        },
        "tooltip": {
          "placement": "칸 위",
          "offset": 8,
          "viewportMargin": 8
        }
      }
    },
    {
      "when": {
        "axis": "dual"
      },
      "enabled": {
        "tickLabel": {
          "foreground": "chart-{계열 색}"
        }
      }
    },
    {
      "when": {
        "legend": "shown"
      },
      "enabled": {
        "legendTile": {
          "background": "chart-{색}-subtle"
        }
      },
      "disabled": {
        "legendTile": {
          "cursor": "not-allowed",
          "scale": "없음"
        }
      }
    },
    {
      "when": {
        "legend": "hidden"
      },
      "enabled": {
        "legendTile": {
          "background": {
            "light": "#FFFFFF",
            "dark": "#242938"
          },
          "borderWidth": 1,
          "borderColor": {
            "light": "#E5E8EF",
            "dark": "#404757"
          }
        }
      },
      "hovered": {
        "legendTile": {
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          }
        }
      }
    },
    {
      "when": {
        "palette": "blue"
      },
      "enabled": {
        "series": {
          "color": {
            "light": "#1D6EC9",
            "dark": "#69ABFF"
          }
        }
      }
    },
    {
      "when": {
