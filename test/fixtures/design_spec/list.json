        "icon": {
          "color": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "tile": {
          "background": {
            "light": "#F5F6FA",
            "dark": "#353B4D"
          },
          "color": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "title": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "detail": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "suffixText": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "suffixIcon": {
          "color": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        }
      }
    },
    {
      "when": {
        "align": "top"
      },
      "enabled": {
        "item": {
          "alignItems": "flex-start"
        }
      }
    },
    {
      "when": {
        "highlight": "highlighted"
      },
      "enabled": {
        "background": {
          "background": {
            "light": "#E8F1FE",
            "dark": "#20314E"
          }
        }
      },
      "hovered": {
        "background": {
          "background": {
            "light": "#D7E5FC",
            "dark": "#1F3A69"
          }
        },
        "detail": {
          "foreground": {
            "light": "#535866",
            "dark": "#B7BDCC"
          }
        },
        "suffixText": {
          "foreground": {
            "light": "#535866",
            "dark": "#B7BDCC"
          }
        }
      },
      "pressed": {
        "background": {
          "background": {
            "light": "#D7E5FC",
            "dark": "#1F3A69"
          }
        },
        "detail": {
          "foreground": {
            "light": "#535866",
            "dark": "#B7BDCC"
          }
        },
        "suffixText": {
          "foreground": {
            "light": "#535866",
            "dark": "#B7BDCC"
          }
        }
      }
    },
    {
      "when": {
        "width": "narrow"
      },
      "enabled": {
        "item": {
          "alignItems": "flex-start"
        },
        "body": {
          "paddingRight": 0
        },
        "suffix": {
          "placement": "본문 아래",
          "marginTop": 2,
          "textAlign": "start",
          "lineBreak": "금액은 쉼표 뒤 · 글 값은 줄 끝"
        }
      }
    },
    {
      "when": {
        "nest": "parent"
      },
      "enabled": {
        "item": {
          "paddingLeft": 4
        },
        "expandButton": {
          "size": 44,
          "radius": 10,
          "iconSize": 20,
          "color": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          },
          "rotate": "0deg",
          "marginRight": 4,
          "background": "transparent",
          "cursor": "pointer",
          "touchTarget": "44 × 44",
          "name": "{카테고리} 하위 카테고리",
          "transitionProperty": "rotate, background-color"
        },
        "subList": {
          "display": "숨김"
        }
      },
      "hovered": {
        "expandButton": {
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          }
        }
      },
      "pressed": {
        "expandButton": {
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          },
          "scale": "2px 거리 축소"
        }
      },
      "focused": {
        "expandButton": {
          "outlineWidth": 2,
          "outlineOffset": -2,
          "outlineColor": {
            "light": "#0147AD",
            "dark": "#7AA9F6"
          }
        }
      }
    },
    {
      "when": {
        "nest": "child"
      },
      "enabled": {
        "item": {
          "paddingLeft": 104
        }
      }
    },
    {
      "when": {
        "expanded": "expanded"
      },
      "enabled": {
        "expandButton": {
          "rotate": "90deg"
        },
        "subList": {
          "display": "보임"
        }
      }
    },
    {
      "when": {
        "mode": "fixed"
      },
      "enabled": {
        "expandButton": {
          "display": "빈 자리"
        },
        "subList": {
          "display": "보임"
        }
      }
    }
  ],
  "motion": {
    "누름 · 호버 — 바탕": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "background-color",
        "inset",
        "border-radius"
      ],
      "note": "바탕이 좌우 6 들어오며 모서리 10 으로 둥글어진다"
    },
    "누름 — 콘텐츠": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "scale"
      ],
      "note": "콘텐츠 층만 2px 거리 축소(줄은 세로로 1px 남짓) — 모션 줄이기면 하지 않는다"
    },
    "하위 줄 — 펼침 · 접힘": {
      "duration": "300ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "height"
      ],
      "note": "Accordion 과 같은 300ms(2026-10-10 사용자 결정 3A)"
    },
    "하위 줄 — 모션 줄이기": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "opacity"
      ],
      "note": "높이를 움직이지 않고 하위 줄이 150ms 서서히 나타나고 사라진다(v104 · Accordion 과 같다)"
    },
    "꺾쇠 단추 — 회전": {
      "duration": "300ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "rotate"
      ],
      "note": "0 → 90°(오른쪽 → 아래) — 모션 줄이기면 바로"
    }
  },
  "notes": [
    {
      "rule": 0,
      "state": "enabled",
      "slot": "root",
      "prop": "gap",
      "note": "줄 사이 간격 없음 — 줄의 위아래 여백이 간격이다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "item",
      "prop": "paddingX",
      "note": "화면 가장자리 규칙 24(SEED 16). 안쪽 여백을 바꿔도 이보다 좁히지 않는다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "item",
      "prop": "cursor",
      "note": "누르는 줄만"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "item",
      "prop": "touchTarget",
      "note": "누르는 줄은 줄 전체 — 한 줄짜리도 46 이라 44 를 넘는다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "background",
      "prop": "transitionProperty",
      "note": "누르면 바탕이 안쪽으로 들어오며 둥글어진다(SEED)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "background",
      "prop": "transitionDuration",
      "note": "SEED 는 바탕 색만 color-transition, 들임 · 모서리는 d3 — 둘 다 150ms 라 하나로 적었다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "content",
      "prop": "stackBelow",
      "note": "줄 안 폭(줄 폭 − 좌우 여백, 앞 붙이개 · 꺾쇠 자리 포함)이 이보다 좁으면 width narrow — em 은 제목 글자(t5) 크기라 글자 배율을 따라 커진다. 보통 글자에서 256 이라 320 폰(줄 안 272)까지 한 줄이고, 360 폰(312)은 글자 약 122% 부터(130% 면 15em) 값이 아래로 간다. 웹은 16rem(t5 = 1rem) 컨테이너 쿼리, 앱은 LayoutBuilder 로 16 × t5 × 글자 배율 — 둘이 같은 값을 잰다(2026-10-17 사용자 결정 03-D 결정 1 B)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "tile",
      "prop": "radius",
      "note": "크기 × 0.3 — 타일 크기를 바꾸면 모서리도 그 비율로"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "tile",
      "prop": "background",
      "note": "카테고리 색의 옅은 바탕(v111) — 이체 줄은 회색(chart-gray-weak, 2026-10-04). 은행 · 카드 같은 물건 줄은 Logo Tile(logo-tile.yaml)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "tile",
      "prop": "color",
      "note": "카테고리 색 — 옅은 바탕 위 3:1 이상(가장 낮은 yellow 라이트 3.63). 이체 줄은 chart-gray. 아이콘이 없는 카테고리는 태그 아이콘(lucide tag) — 빈 칸 · 첫 글자를 넣지 않는다(2026-10-04)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "body",
      "prop": "paddingRight",
      "note": "본문과 뒤 붙이개 사이"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "body",
      "prop": "flexGrow",
      "note": "남는 폭을 본문이 쓰고, 값이 길면 본문이 먼저 양보한다(SEED content flexGrow 1)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "body",
      "prop": "minWidth",
      "note": "본문은 한 글자(1em)까지 준다 — em 은 제목 글자(t5 16) 크기다. 버튼이 물려받은 글자(14)로 재면 24 가 된다 — 레시피는 calc(var(--text-t5) + 10px), 뒤 여백 10 은 따로 더해 보통 글자에서 26(2026-10-17 고침 03D-005). 값이 본문 위로 넘쳐 겹치지 않게(2026-10-15 사용자 결정 — 구현 세션 질문 Q-001, 안 A)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "title",
      "prop": "fontWeight",
      "note": "SEED 와 같다 — 굵기는 목록 제목 · 금액 같은 자리에 남긴다(사용자 결정)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "title",
      "prop": "overflowWrap",
      "note": "평소에는 단어 단위(v114 — keep-all + break-word)로 바꾸고, 본문이 낱말 하나보다 좁아질 때만 글자 사이에서 끊어 칸 밖으로 넘치지 않는다(Q-001 A)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "detail",
      "prop": "overflowWrap",
      "note": "글 설명도 제목처럼 — 본문이 낱말 하나보다 좁아질 때만 글자 사이에서 끊어 뒤 붙이개에 닿지 않는다(2026-10-15 사용자 결정 — 구현 세션 질문 Q-001, 안 A). Tag Group 설명은 그 스펙대로 한 줄 말줄임"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "suffix",
      "prop": "shrink",
      "note": "줄지 않는다(SEED suffix flexShrink 0) — 값이 길면 본문이 1em 까지 양보한다. 금액 · 화살표 · 컨트롤 · 작은 버튼은 한 덩어리로 선다. 값을 줄여 적는 것(억 단위 등)은 그 화면이 정한다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "suffixText",
      "prop": "shrink",
      "note": "글 값(이메일 · 계좌번호 · 긴 이름 — suffix 에 글을 그대로 넘긴 것)만 — 본문이 1em 이 된 뒤에야 준다(최소 폭 0)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "suffixText",
      "prop": "overflowWrap",
      "note": "남는 폭보다 길면 줄 끝에서 끊는다 — 본문 위로 넘쳐 덮지 않는다(Q-001 A). 말줄임으로 자르지 않는다(10A)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "divider",
      "prop": "background",
      "note": "기본은 줄 폭 전체 — 들일 때(inset)는 좌우 24"
    },
    {
      "rule": 0,
      "state": "hovered",
      "slot": "background",
      "prop": "insetX",
      "note": "바탕이 좌우로 6 들어온다(SEED marginX)"
    },
    {
      "rule": 0,
      "state": "hovered",
      "slot": "background",
      "prop": "radius",
      "note": "카드 안에서는 카드 모서리 − 카드 가장자리에서 바탕까지 거리(동심 모서리) — 목록의 itemRadius 로 바꾼다. 모서리 16 카드에 줄을 바로 넣으면 16 − 6"
    },
    {
      "rule": 0,
      "state": "pressed",
      "slot": "content",
      "prop": "scale",
      "note": "콘텐츠 층만 — 기준 길이 max(높이, 폭 ÷ 4, 24) 에서 2px. 줄은 폭 ÷ 4 가 기준이라 세로로는 1px 남짓 준다. 줄 안의 스위치 · 체크 · 라디오는 따로 줄지 않는다(v104)"
    },
    {
      "rule": 0,
      "state": "focused",
      "slot": "focusRing",
      "prop": "offset",
      "note": "줄 안쪽 — 화면 폭 줄은 바깥 링이 잘린다"
    },
    {
      "rule": 2,
      "state": "enabled",
      "slot": "background",
      "prop": "background",
      "note": "바탕만 바뀐다 — 점 · 막대는 두지 않는다(사용자 결정, SEED)"
    },
    {
      "rule": 2,
      "state": "hovered",
      "slot": "detail",
