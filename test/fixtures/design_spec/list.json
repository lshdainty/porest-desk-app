            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "foreground": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          }
        },
        "suffix": {
          "gap": 4
        },
        "suffixText": {
          "typography": {
            "fontSize": 16,
            "lineHeight": 22,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "foreground": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          }
        },
        "suffixIcon": {
          "size": 18,
          "color": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          }
        },
        "divider": {
          "height": 1,
