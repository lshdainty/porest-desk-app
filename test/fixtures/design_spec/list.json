{
  "name": "List",
  "source": "specs/components/list.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "d0ae84eb0c4d"
  },
  "slots": {
    "root": "목록(List) — 줄을 세로로 잇는다. 배경 · 줄 사이 간격 없음",
    "item": "한 줄(List Item) — 누르는 줄은 줄 전체가 누르는 영역",
    "background": "바탕 층 — 누름 · 호버 · 강조 바탕. 콘텐츠 뒤에 깔리고 줄지 않는다",
    "content": "콘텐츠 층 — 앞 · 본문 · 뒤를 담는다. 누르면 이 층만 준다",
    "prefix": "앞 붙이개 자리",
    "icon": "앞 아이콘 — 설정 · 메뉴 줄",
    "tile": "앞 타일(색 상자) — 색이 뜻을 가진 내용 줄(거래 · 카테고리 · 알림 종류)",
    "body": "본문 — 제목 + 설명",
    "title": "제목",
    "detail": "설명",
    "suffix": "뒤 붙이개 자리 — 값 글자 · 화살표 · 컨트롤 · 작은 버튼",
    "suffixText": "뒤 값 글자",
    "suffixIcon": "뒤 아이콘 — 오른쪽 화살표",
    "divider": "줄 사이 선(ListDivider) — 필요할 때만",
    "expandButton": "줄 앞 꺾쇠 단추 — 부모 줄의 하위 줄을 펼치고 접는다(누르는 44). 줄을 누르면 하는 일(편집)과 따로 눌린다",
    "subList": "하위 줄 묶음 — 부모 줄 바로 아래에서 펼치고 접힌다",
    "focusRing": "키보드 포커스 링(웹) — 줄 안쪽"
  },
  "axes": {
    "align": [
      "center",
      "top"
    ],
    "highlight": [
      "none",
      "highlighted"
    ],
    "nest": [
      "none",
      "parent",
      "child"
    ],
    "expanded": [
      "collapsed",
      "expanded"
    ],
    "width": [
      "regular",
      "narrow"
    ],
    "mode": [
      "foldable",
      "fixed"
    ]
  },
  "defaults": {
    "align": "center",
    "highlight": "none",
    "nest": "none",
    "expanded": "collapsed",
    "mode": "foldable",
    "width": "regular"
  },
  "states": [
    "enabled",
    "hovered",
    "focused",
    "pressed",
    "disabled"
  ],
  "rules": [
    {
      "when": {},
      "enabled": {
        "root": {
          "gap": 0
        },
        "item": {
          "paddingY": 12,
          "paddingX": 24,
          "alignItems": "center",
          "cursor": "pointer",
          "touchTarget": "44 × 44"
        },
        "background": {
          "background": "transparent",
          "insetX": 0,
          "radius": 0,
          "transitionProperty": "background-color, inset, border-radius",
          "transitionDuration": "150ms",
          "transitionEasing": "cubic-bezier(0.35, 0, 0.35, 1)"
        },
        "content": {
          "transitionProperty": "scale",
          "transitionDuration": "150ms",
          "transitionEasing": "cubic-bezier(0, 0, 0.15, 1)",
          "stackBelow": "16em"
        },
        "prefix": {
          "paddingRight": 12
        },
        "icon": {
          "size": 22,
          "color": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          }
        },
        "tile": {
          "size": 40,
          "radius": 12,
          "background": "chart-{색}-weak",
          "iconSize": 20,
          "color": "chart-{색}"
        },
        "body": {
          "gap": 2,
          "paddingRight": 10,
          "flexGrow": 1,
          "minWidth": "1em"
        },
        "title": {
          "typography": {
            "fontSize": 16,
            "lineHeight": 22,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 400,
          "foreground": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          },
          "overflowWrap": "anywhere"
        },
        "detail": {
          "typography": {
            "fontSize": 13,
            "lineHeight": 18,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "foreground": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          },
          "overflowWrap": "anywhere"
        },
        "suffix": {
          "gap": 4,
          "shrink": 0
        },
        "suffixText": {
          "typography": {
            "fontSize": 16,
            "lineHeight": 22,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "foreground": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          },
          "shrink": 1,
          "overflowWrap": "anywhere"
        },
        "suffixIcon": {
          "size": 18,
          "color": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          }
        },
        "divider": {
          "height": 1,
          "background": {
            "light": "#EDEFF3",
            "dark": "#353B4D"
          }
        }
      },
      "hovered": {
