        "tile": {
          "background": {
            "light": "#F5F6FA",
            "dark": "#353B4D"
          },
          "color": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "title": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "detail": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "suffixText": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "suffixIcon": {
          "color": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        }
