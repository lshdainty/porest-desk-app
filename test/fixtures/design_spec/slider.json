  "slots": {
    "root": "Slider — 손잡이 줄 + 표식. 폭은 놓인 자리",
    "control": "손잡이 줄 — 높이 44 전체가 누르는 자리(트랙을 누르면 그 자리로 건너뛴다)",
    "track": "트랙 — 고를 수 있는 범위",
    "fill": "채움 — 최솟값에서 손잡이까지(범위는 두 손잡이 사이)",
    "tick": "눈금 — 구간이 2 ~ 5개일 때만, 트랙 · 채움을 끊는 틈",
    "thumb": "손잡이 — 원. 보조 기술에는 role=\"slider\"",
    "valueIndicator": "말풍선 — 손잡이 위 지금 값(끄는 동안 · 마우스를 올렸을 때 · 키보드 포커스일 때)",
    "markers": "표식 — 아래 양 끝 값(2 ~ 5 구간이면 단계마다)",
    "headerValue": "머리 값 — Field 머리 오른쪽의 지금 값, 늘 보인다",
    "focusRing": "키보드 포커스 링 — 손잡이 둘레"
  },
  "axes": {
    "mode": [
      "single",
      "range"
    ],
    "ticks": [
      "none",
      "discrete"
    ]
  },
  "defaults": {
    "mode": "single",
    "ticks": "none"
  },
  "states": [
    "enabled",
    "hovered",
    "focused",
    "pressed",
    "disabled"
