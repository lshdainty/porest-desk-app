{
  "name": "Icon Picker",
  "source": "specs/components/icon-picker.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "97d2f704108f"
  },
  "slots": {
    "trigger": "트리거 — Input Button. 라벨 \"아이콘\"(Field) · 앞 지금 아이콘 · 값 = 아이콘 이름 · 뒤 chevron-down",
    "surface": "여는 자리 — 1280 미만 Bottom Sheet(\"아이콘\") · 이상 Popover(머리 없이 · 이름 \"아이콘\")",
    "search": "찾기 칸 — Input 밑줄형 · 앞 돋보기 · 지우기. 위에 붙는다",
    "scroll": "스크롤 상자 — 묶음 머리 · 격자가 넘치면 이 안에서 스크롤한다(끝 흐림). 찾기 칸은 그 밖이라 늘 위에 있다",
    "groupHeader": "묶음 머리 — \"식비\" · \"카페\" … 찾는 동안은 없다",
    "grid": "격자 — listbox. 칸 48 을 들어가는 만큼(폰 시트 6열 · 팝오버 7열)",
    "cell": "칸 — 48 · 모서리 12. 이름은 한국어 이름",
    "icon": "칸 아이콘 — 24",
    "count": "결과 수 — 화면 밖 알림",
    "empty": "결과 없음 — Result Section medium",
    "focusRing": "키보드 포커스 링 — 칸 바깥"
  },
  "axes": {
    "selected": [
      "unselected",
      "selected"
    ],
    "surface": [
      "sheet",
      "popover"
    ]
  },
  "defaults": {
    "selected": "unselected",
    "surface": "sheet"
  },
  "states": [
    "enabled",
    "hovered",
    "focused",
    "pressed"
  ],
  "rules": [
    {
      "when": {},
      "enabled": {
        "trigger": {
          "component": "Input Button"
        },
        "search": {
          "variant": "underline",
          "match": "이름 · 찾는 말 · id"
        },
        "groupHeader": {
          "typography": {
            "fontSize": 14,
            "lineHeight": 19,
            "fontWeight": 500,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 500,
          "foreground": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          },
          "paddingTop": 12,
          "paddingBottom": 8
        },
        "grid": {
          "role": "listbox",
          "columns": "들어가는 만큼",
          "columnGapMin": 4,
          "rowGap": 4,
          "searchGap": 12,
          "keyboard": "← → · ↑ ↓ · Home · End · Enter · Space"
        },
        "cell": {
          "size": 48,
          "radius": 12,
          "background": "transparent",
          "cursor": "pointer",
          "touchTarget": "48 × 48",
          "name": "한국어 이름",
          "role": "option"
        },
        "icon": {
          "size": 24,
          "strokeWidth": 2,
          "color": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          }
        },
        "count": {
          "display": "화면 밖"
        },
        "empty": {
          "size": "Result Section medium"
        }
      },
      "hovered": {
        "cell": {
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          }
        }
      },
      "pressed": {
        "cell": {
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          },
          "scale": "칸 2px 거리 축소",
          "scaleDuration": "150ms",
          "scaleEasing": "cubic-bezier(0, 0, 0.15, 1)"
        }
      },
      "focused": {
        "focusRing": {
          "width": 2,
          "offset": 2,
          "color": {
            "light": "#0147AD",
            "dark": "#7AA9F6"
          }
        }
      }
    },
    {
      "when": {
        "selected": "selected"
      },
      "enabled": {
        "cell": {
          "borderWidth": 2,
          "borderColor": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          }
        },
        "icon": {
          "strokeWidth": 2.5
        }
      }
    },
    {
      "when": {
        "surface": "sheet"
      },
      "enabled": {
        "surface": {
          "component": "Bottom Sheet",
          "paddingX": 24
        },
        "grid": {
          "columns": 6
        },
        "scroll": {
          "scrollFog": "켬"
        },
        "search": {
          "height": 40
        }
      }
    },
    {
      "when": {
        "surface": "popover"
      },
      "enabled": {
        "surface": {
          "component": "Popover",
          "width": 408,
          "paddingX": 24
        },
        "grid": {
          "columns": 7
        },
        "scroll": {
          "scrollFog": "켬"
        },
        "search": {
          "height": 34
        }
      }
    }
  ],
  "motion": {
    "호버 · 누름 — 바탕": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "background-color"
      ]
    },
    "누름 — 칸": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "scale"
      ],
      "note": "칸 2px 거리 축소 — 모션 줄이기면 하지 않는다"
    }
  },
  "notes": [
    {
      "rule": 0,
      "state": "enabled",
      "slot": "trigger",
      "prop": "component",
      "note": "input-button.yaml — 크기 반응형(large 52 · medium 40). 라벨 \"아이콘\"(Field), 앞 아이콘 = 지금 아이콘(large 20 · medium 16 · fg-neutral-muted), 값 = 아이콘의 한국어 이름(\"커피\"), 뒤 chevron-down. 이름은 \"아이콘, 커피\"(라벨 + 값). 아이콘이 없는 항목은 태그 + \"태그\", 세트 밖 저장 아이콘은 그 아이콘 + \"지금 아이콘\""
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "search",
      "prop": "variant",
      "note": "Input 밑줄형 — 시트 · 팝오버에 입력이 하나뿐인 목록 위 찾기(Searchable List 와 같다). 앞 돋보기 · 지우기 · placeholder \"아이콘 이름 검색\" · 이름 \"아이콘 검색\". 목록이 스크롤해도 위에 붙는다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "search",
      "prop": "match",
      "note": "찾는 말과 이름 · 찾는 말 · lucide 이름을 소문자로 바꾸고 공백을 뺀 뒤 부분 일치(\"커피\" → 커피 · 원두, \"월세\" → 집). 들고 있는 표라 치는 대로 바로 거른다 — 결과는 세트 차례 그대로, 묶음 머리 없이"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "groupHeader",
      "prop": "typography",
      "note": "List Header mediumWeak — 14 · 500"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "groupHeader",
      "prop": "foreground",
      "note": "시트 · 팝오버 위 5.50 · 다크 5.27"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "grid",
      "prop": "role",
      "note": "이름 \"아이콘\". 묶음은 role=\"group\" + 머리로 이름(aria-labelledby). 격자에 Tab 하나(고른 칸, 없으면 첫 칸)"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "grid",
      "prop": "columns",
      "note": "칸 48 · 사이 최소 4 로 들어가는 열 — 폰 시트(본문 312 ~ 342) 6열 · 팝오버(본문 360) 7열. 남는 폭은 칸 사이에 고르게 나눈다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "grid",
      "prop": "columnGapMin",
      "note": "칸 사이 최소 4 — 남는 폭은 칸 사이에 고르게"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "grid",
      "prop": "rowGap",
      "note": "줄 사이 4"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "grid",
      "prop": "searchGap",
      "note": "찾는 동안(묶음 머리 없음) 격자 위 12 — 묶음 머리 위 여백(12)과 같다. 스크롤 상자의 흐림 여백(위 20)이 그 바깥에 더해져 찾기 칸 ↔ 격자는 32, 묶음으로 볼 때 찾기 칸 ↔ 첫 머리 글도 32 로 두 보기가 같다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "grid",
      "prop": "keyboard",
      "note": "← → 는 차례대로(줄 끝에서 다음 줄 · 다음 묶음으로), ↑ ↓ 는 보이는 위아래 줄의 가장 가까운 칸(묶음을 넘는다), Home · End 는 그 줄의 처음 · 끝, Enter · Space 로 고른다. 찾기 칸에서 ↓ 는 격자의 첫 칸으로. Esc 는 찾는 말이 있으면 먼저 지우고(초점은 찾기 칸), 없으면 닫는다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "cell",
      "prop": "touchTarget",
      "note": "AA ✓ · AAA ✓ — SEED Iconography \"24px 크기에서는 44px 이상\""
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "cell",
      "prop": "name",
      "note": "\"커피\" — 영어 lucide 이름을 이름으로 두지 않는다. 마우스는 같은 글의 툴팁"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "icon",
      "prop": "size",
      "note": "lucide 기본 격자 — v106 의 24"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "icon",
      "prop": "strokeWidth",
      "note": "lucide 기본"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "icon",
      "prop": "color",
      "note": "시트 · 팝오버 위 16.41 · 다크 11.62"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "count",
      "prop": "display",
      "note": "aria-live=\"polite\" — 치기를 멈추고 500ms 뒤 \"검색 결과 2개\" 를 한 번 읽는다. 0건은 Result Section 이 알린다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "empty",
      "prop": "size",
      "note": "격자 자리 가운데 — 제목 \"'{검색어}'에 대한 아이콘이 없어요\" · 설명 \"다른 말로 찾거나 묶음에서 골라주세요.\" · role=\"status\""
    },
    {
      "rule": 0,
      "state": "hovered",
      "slot": "cell",
      "prop": "background",
      "note": "시트 · 팝오버(bg-layer-floating) 위의 누름 색 — Menu 와 같다"
    },
    {
      "rule": 0,
      "state": "pressed",
      "slot": "cell",
      "prop": "scale",
      "note": "기준 48 — Feedback 의 눌림 피드백(v104). 모션 줄이기면 하지 않는다"
    },
    {
      "rule": 0,
      "state": "focused",
      "slot": "focusRing",
      "prop": "offset",
      "note": "칸 바깥 — 키보드 포커스에만"
    },
    {
      "rule": 1,
      "state": "enabled",
      "slot": "cell",
      "prop": "borderWidth",
      "note": "안쪽에 덧그린다 — 아이콘이 밀리지 않는다(Select Box v113 의 고른 테두리와 같다). 바탕은 칠하지 않는다(반전 · 브랜드 채움은 고르지 않았다 — 17B)"
    },
    {
      "rule": 1,
      "state": "enabled",
      "slot": "cell",
      "prop": "borderColor",
      "note": "시트 · 팝오버 위 16.41 · 다크 11.62"
    },
    {
      "rule": 1,
      "state": "enabled",
      "slot": "icon",
      "prop": "strokeWidth",
      "note": "v106 — 선택은 선 2.5"
    },
    {
      "rule": 2,
      "state": "enabled",
      "slot": "surface",
      "prop": "component",
      "note": "bottom-sheet.yaml — 제목 \"아이콘\" · 닫기. 고르면 닫힌다(\"완료\" 없음)"
    },
    {
      "rule": 2,
      "state": "enabled",
      "slot": "surface",
      "prop": "paddingX",
      "note": "본문 좌우 24(Bottom Sheet)"
    },
    {
      "rule": 2,
      "state": "enabled",
      "slot": "grid",
      "prop": "columns",
      "note": "폰 본문 312 ~ 342 — 48 × 6 + 4 × 5 = 308 이 들어간다. 본문이 308 보다 좁으면(320 폰) 들어가는 만큼(5열), 태블릿 시트(432)도 6열"
    },
    {
      "rule": 2,
      "state": "enabled",
      "slot": "scroll",
      "prop": "scrollFog",
      "note": "격자가 넘친다 — Bottom Sheet 본문의 끝 흐림(Scroll Fog overlayBody, 위 20 · 아래 80 늘 켜짐 · 2026-10-03 규칙). 찾기 칸은 스크롤 상자 밖이라 흐리지 않는다"
    },
    {
      "rule": 2,
      "state": "enabled",
      "slot": "search",
      "prop": "height",
      "note": "밑줄형 large — 글 18 / 24 · 돋보기 24"
    },
    {
      "rule": 3,
      "state": "enabled",
      "slot": "surface",
      "prop": "component",
      "note": "popover.yaml — 머리 없이(고르는 패널) · 이름 aria-label \"아이콘\" · 트리거 아래 8 · 최대 높이 600"
    },
    {
      "rule": 3,
      "state": "enabled",
      "slot": "surface",
      "prop": "width",
      "note": "칸 48 × 7 + 사이 4 × 6 = 360 + 좌우 24 × 2 — Popover 폭 320 ~ 480 안"
    },
    {
      "rule": 3,
      "state": "enabled",
      "slot": "surface",
      "prop": "paddingX",
      "note": "본문 좌우 24"
    },
    {
      "rule": 3,
      "state": "enabled",
      "slot": "grid",
      "prop": "columns",
      "note": "본문 360 = 48 × 7 + 4 × 6"
    },
    {
      "rule": 3,
      "state": "enabled",
      "slot": "scroll",
      "prop": "scrollFog",
      "note": "격자가 넘친다 — Popover 본문의 끝 흐림(Scroll Fog overlayBody, 위 20 · 아래 80 늘 켜짐 · 2026-10-03 규칙). 찾기 칸은 스크롤 상자 밖"
    },
    {
      "rule": 3,
      "state": "enabled",
      "slot": "search",
      "prop": "height",
      "note": "밑줄형 medium — 글 16 / 22 · 돋보기 20"
    }
  ]
}
