  "slots": {
    "root": "알약 — 모서리 full. 글만큼 넓어지고 줄바꿈 · 말줄임하지 않는다",
    "label": "글 — 명사로 짧게, 한 줄",
    "prefixIcon": "앞 아이콘 — 묶음 안에서 모두 두거나 모두 뺀다",
    "suffixIcon": "뒤 아이콘 — 여는 칩의 아래 화살표",
    "removeButton": "입력값 칩의 지우기 — 이름 \"{글} 지우기\", 칩 안에서 따로 눌린다",
    "icon": "아이콘만 있는 칩의 아이콘 — 이름(aria-label) 필수",
    "focusRing": "키보드 포커스 링(웹)",
    "group": "묶음(Chip Group) — 줄바꿈(폼 · 시트 안) 또는 한 줄 가로 스크롤(목록 위 필터 바 · 제안 줄)",
    "scrollRow": "가로 스크롤 줄 — 목록 위 필터 바 · 제안 줄만(줄바꿈 묶음에는 없다). 줄을 화면 끝까지 낸다"
  },
  "axes": {
    "variant": [
      "solid",
      "outlineStrong",
      "outlineWeak"
    ],
    "size": [
      "small",
      "medium",
      "large"
    ],
    "layout": [
      "withText",
      "iconOnly"
    ],
    "selected": [
      "unselected",
      "selected"
    ]
  },
  "defaults": {
    "variant": "outlineWeak",
    "size": "medium",
    "layout": "withText",
    "selected": "unselected"
  },
  "states": [
    "enabled",
    "hovered",
    "pressed",
    "focused",
    "disabled"
