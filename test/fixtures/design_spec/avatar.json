        "root": {
          "size": 48
        },
        "initial": {
          "fontSize": 19
        }
      }
    },
    {
      "when": {
        "size": "56"
      },
      "enabled": {
        "root": {
          "size": 56
        },
        "initial": {
          "fontSize": 22
        }
      }
    },
    {
      "when": {
        "size": "64"
      },
      "enabled": {
        "root": {
          "size": 64
