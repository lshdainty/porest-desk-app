{
  "name": "Avatar",
  "source": "specs/components/avatar.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "97d2f704108f"
  },
  "slots": {
    "root": "원 — 폭 = 높이. 사진 또는 이니셜을 원으로 자른다",
    "image": "사진 — 원을 채운다. 불러오는 동안 · 실패하면 이니셜이 보인다",
    "initial": "이니셜 — 사진이 없을 때. 이름의 첫 글자 + 이름 색 바탕",
    "border": "1px 안쪽 테두리 — 모든 크기, 사진 · 이니셜 위에 겹친다(흰 사진이 바탕에 묻히지 않게)",
    "uploadOverlay": "올리는 중 덮개 — 원 위 딤 + 값 있는 원 24. 사진 바꾸기 자리(edit photo)에만",
    "editActions": "사진 바꾸기 버튼 줄 — 아바타 아래 늘 보이는 \"사진 바꾸기\" · \"사진 지우기\". 사진 바꾸기 자리(edit photo)에만"
  },
  "axes": {
    "size": [
      "20",
      "24",
      "36",
      "42",
      "48",
      "56",
      "64",
      "80",
      "96",
      "108"
    ],
    "edit": [
      "none",
      "photo"
    ]
  },
  "defaults": {
    "size": "48",
    "edit": "none"
  },
  "states": [
    "enabled",
    "uploading"
  ],
  "rules": [
    {
      "when": {},
      "enabled": {
        "root": {
          "radius": 9999
        },
        "image": {
          "objectFit": "cover"
        },
        "initial": {
          "background": "chart-{이름 색}",
          "foreground": {
            "light": "#FFFFFF",
            "dark": "#242938"
          },
          "fontWeight": 700,
          "lineHeight": 1,
          "textTransform": "uppercase"
        },
        "border": {
          "borderWidth": 1,
          "borderColor": {
            "light": "#0000000C",
            "dark": "#FFFFFF0D"
          }
        }
      }
    },
    {
      "when": {
        "size": "20"
      },
      "enabled": {
        "root": {
          "size": 20
        },
        "initial": {
          "fontSize": 10
        }
      }
    },
    {
      "when": {
        "size": "24"
      },
      "enabled": {
        "root": {
          "size": 24
        },
        "initial": {
          "fontSize": 10
        }
      }
    },
    {
      "when": {
        "size": "36"
      },
