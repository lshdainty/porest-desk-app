      "when": {
        "position": "first"
      },
      "enabled": {
        "itemMenu": {
          "moveEarlier": "막힘",
          "makeCover": "막힘"
        }
      }
    },
    {
      "when": {
        "position": "last"
      },
      "enabled": {
        "itemMenu": {
          "moveLater": "막힘"
        }
      }
    }
