          "transitionEasing": "cubic-bezier(0.35, 0, 0.35, 1)"
        },
        "dropzoneLabel": {
          "typography": {
            "fontSize": 14,
            "lineHeight": 19,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 500,
          "foreground": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          },
          "text": "파일을 여기로 끌어다 놓으세요"
        },
        "pickButton": {
          "display": "보임",
          "variant": "neutralWeak",
          "size": "small",
          "label": "파일 선택"
        }
      },
      "disabled": {
        "dropzone": {
          "borderColor": {
            "light": "#E5E8EF",
            "dark": "#404757"
          },
          "dropTarget": "받지 않음"
        },
        "dropzoneLabel": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        }
      },
      "dragOver": {
        "dropzone": {
          "borderColor": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          },
          "background": {
            "light": "#F7F8FD",
            "dark": "#353B4D"
          }
        },
        "pickButton": {
          "background": {
            "light": "#F5F6FA",
            "dark": "#353B4D"
          }
        }
      }
    },
    {
      "when": {
        "layout": "dropzone",
        "screen": "wide",
        "capacity": "full"
      },
      "enabled": {
        "dropzone": {
          "borderColor": {
            "light": "#E5E8EF",
            "dark": "#404757"
          },
          "dropTarget": "받지 않음"
        },
        "dropzoneLabel": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        }
      },
      "dragOver": {
        "dropzone": {
          "borderColor": {
            "light": "#E5E8EF",
            "dark": "#404757"
