          "color": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "name": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "size": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        }
      }
    },
    {
      "when": {
        "kind": "image",
        "status": "uploading"
      },
      "enabled": {
        "backdrop": {
          "display": "보임",
          "background": {
            "light": "rgba(0, 0, 0, 0.50)",
            "dark": "rgba(0, 0, 0, 0.65)"
          }
        },
        "progressCircle": {
          "display": "보임",
          "tone": "staticWhite"
        }
      }
    },
    {
      "when": {
        "kind": "file",
        "status": "uploading"
      },
      "enabled": {
        "thumbnailIcon": {
          "display": "none"
        },
        "progressCircle": {
          "display": "보임",
          "tone": "neutral"
        }
      }
    },
    {
      "when": {
        "kind": "image",
        "status": "error"
      },
      "enabled": {
        "backdrop": {
          "display": "보임",
          "background": "rgba(0, 0, 0, 0.65)"
        },
        "actionButton": {
          "display": "보임",
          "color": "#FFFFFF"
        }
      }
    },
    {
      "when": {
        "kind": "file",
        "status": "error"
      },
      "enabled": {
        "thumbnail": {
          "display": "none"
        },
        "meta": {
          "display": "none"
        },
        "actionButton": {
          "display": "보임",
          "color": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          },
          "width": "카드 폭"
        }
      }
    },
    {
      "when": {
        "capacity": "full"
      },
      "enabled": {
        "trigger": {
          "ariaDisabled": "true",
          "cursor": "not-allowed"
        },
        "triggerIcon": {
          "color": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "count": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "countMax": {
          "foreground": {
            "light": "#8A91A0",
            "dark": "#838997"
          }
        },
        "pickButton": {
          "disabled": "true"
        }
      },
      "hovered": {
        "trigger": {
          "background": "transparent"
        }
      },
      "pressed": {
        "trigger": {
          "background": "transparent",
          "scale": "없음"
        }
      }
    },
    {
      "when": {
        "layout": "dropzone"
      },
      "enabled": {
        "items": {
          "bleedX": 0,
          "fog": "없음"
        }
      }
    },
    {
      "when": {
        "layout": "dropzone",
