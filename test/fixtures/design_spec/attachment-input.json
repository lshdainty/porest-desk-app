{
  "name": "AttachmentInput",
  "source": "specs/components/attachment-input.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "6ec6e05f538e"
  },
  "slots": {
    "root": "첨부 칸 전체 — 드롭존(있으면)과 항목 줄을 세로로 담는다. 라벨 · 설명 · 오류는 Field 가 둘레에서 그린다",
    "items": "항목 줄 — 첨부 타일 + 항목을 가로로. 넘치면 가로 스크롤(스크롤바 숨김 · 끝 흐림)",
    "trigger": "첨부 타일 — 누르면 고르기 창(앱은 Menu Sheet). 다 차면 막힌다",
    "triggerIcon": "첨부 타일 아이콘 — 사진을 받으면 lucide image, 파일만 받으면 paperclip",
    "count": "지금 개수 — \"3/10\" 의 3",
    "countMax": "최대 개수 — \"3/10\" 의 /10. 최대가 없으면 개수를 두지 않는다",
    "item": "항목 상자 — 사진 80 × 80 · 파일 160 × 80. 모양은 파일 종류가 정한다",
    "image": "사진 — 항목을 채운다(cover)",
    "thumbnail": "파일 카드의 썸네일 칸 — 파일 아이콘 · 올리는 중 원",
    "thumbnailIcon": "파일 아이콘 — PDF file-text · 표 file-spreadsheet · 그 밖 file",
    "meta": "파일 카드의 이름 · 크기 묶음",
    "name": "파일 이름 — 네 줄까지, 넘치면 확장자를 남기고 줄인다",
    "size": "파일 크기 — \"9.8MB\"",
    "backdrop": "사진 위 덮개 — 올리는 중 · 실패",
    "progressCircle": "올리는 중 원 — 값 있는 Progress Circle 24",
    "actionButton": "다시 시도 — 실패한 항목 가운데(아이콘 + 글)",
    "badge": "대표 띠 — 첫 사진 아래(쓰는 자리만)",
    "removeButton": "지우기 × — 항목 오른쪽 위에 걸친 원",
    "removeMask": "× 둘레 구멍 — 항목 모서리를 × 보다 2 크게 파낸다",
    "dropzone": "드롭존 — 끌어다 놓는 자리(1280 이상 웹)",
    "dropzoneLabel": "드롭존 안내 글",
    "pickButton": "파일 선택 버튼 — 드롭존 안(웹 1280 이상) 또는 드롭존 대신(1280 미만 · 앱)",
    "itemMenu": "항목 메뉴 — 항목을 누르면 열린다(1280 미만 · 앱 Menu Sheet · 이상 Menu). 크게 보기 · 대표로 정하기 · 앞으로 옮기기 · 뒤로 옮기기 | 지우기",
    "focusRing": "키보드 포커스 링 — 모두 부품 안쪽"
  },
  "axes": {
    "layout": [
      "tile",
      "dropzone"
    ],
    "kind": [
      "image",
      "file"
    ],
    "status": [
      "pending",
      "uploading",
      "success",
      "error"
    ],
    "capacity": [
      "open",
      "full"
    ],
    "screen": [
      "wide",
      "narrow"
    ],
    "position": [
      "middle",
      "first",
      "last"
    ]
  },
  "defaults": {
    "layout": "tile",
    "kind": "image",
    "status": "pending",
    "capacity": "open",
    "screen": "wide",
    "position": "middle"
  },
  "states": [
    "enabled",
    "hovered",
    "focused",
    "pressed",
    "dragOver",
    "dragging",
    "readonly",
    "disabled"
  ],
