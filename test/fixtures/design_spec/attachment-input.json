  "motion": {
    "누름 · 올림 — 바탕": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "background-color"
      ],
      "note": "첨부 타일 · ×"
    },
    "누름 — 부품 축소": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "scale"
      ],
      "note": "누른 부품만 2px 거리 축소 — 모션 줄이기면 하지 않는다"
    },
    "끌어 들어옴 — 드롭존": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "border-color",
        "background-color"
      ],
      "note": "테두리 · 바탕이 함께 바뀐다"
    },
    "읽기 전용 · 끄는 중 — 사진 흐림": {
      "duration": "200ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "opacity"
      ],
      "note": "사진 1 → 0.5(SEED opacity 0.2s, 사용자 결정 13B) — 모션 줄이기면 바로"
    },
    "올리는 중 — 채움": {
      "duration": "300ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "stroke-dashoffset"
      ],
      "note": "Progress Circle 의 채움 그대로 — 모션 줄이기면 바로"
    }
  },
