          "foreground": {
            "light": "#62697A",
            "dark": "#A2A8B7"
          }
        },
        "radio": {
          "size": 24
        },
        "status": {
          "size": "Result Section medium"
        },
        "skeleton": {
          "size": "줄 다섯"
        }
