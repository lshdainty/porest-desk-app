  "slots": {
    "root": "묶음 — 위 검색칸 + 아래 결과. 검색 시트 · 팝오버 안 또는 화면 · 단계 안",
    "field": "검색칸 — Input 밑줄형 · 앞 돋보기 · 지우기, 이름 \"검색\"",
    "results": "결과 목록 — listbox. 줄은 List 의 누르는 줄",
    "groupHeader": "분류 머리 — List Header mediumWeak(\"시중은행\" · \"증권사\")",
    "option": "결과 줄 — List 줄. 초점은 받지 않는다",
    "highlight": "강조 바탕 — 화살표 · 마우스로 짚은 줄",
    "prefix": "앞 붙이개 — Logo Tile 40 · 카드 그림 56 · Avatar",
    "title": "제목 — 16 / 22",
    "detail": "설명 — 13 / 18",
    "radio": "오른쪽 라디오 — 지금 고른 값",
    "status": "결과 없음 · 실패 — Result Section medium",
    "skeleton": "불러오는 줄 — 줄 모양 스켈레톤"
  },
  "axes": {
    "size": [
      "large",
      "medium"
    ],
    "placement": [
      "sheet",
      "inline"
    ],
    "prefix": [
      "none",
      "logo",
      "cardArt",
      "avatar"
    ],
    "selected": [
      "other",
      "current"
    ]
  },
  "defaults": {
    "size": "large",
    "placement": "sheet",
    "prefix": "none",
    "selected": "other"
  },
  "states": [
    "enabled",
    "highlighted",
    "pressed"
  ],
  "rules": [
