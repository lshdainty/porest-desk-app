          "filter": "NFC · 대소문자 무시 · 공백 무시 · 포함",
          "pointerLeave": "마우스 강조를 지운다",
          "maxHeight": "놓인 자리"
        },
        "groupHeader": {
          "variant": "mediumWeak"
        },
        "option": {
          "role": "option",
          "paddingY": 12,
          "paddingX": 24,
          "cursor": "pointer",
          "touchTarget": "줄 전체"
        },
        "highlight": {
          "background": "transparent",
          "insetX": 0,
          "radius": 0
        },
        "title": {
          "typography": {
            "fontSize": 16,
