    {
      "when": {
        "size": "medium"
      },
      "enabled": {
        "field": {
          "height": 34
        }
      }
    },
    {
      "when": {
        "placement": "sheet"
      },
      "enabled": {
        "option": {
          "press": "고르고 닫는다"
        }
      }
    },
    {
      "when": {
        "placement": "inline"
      },
      "enabled": {
        "option": {
          "press": "라디오만 바뀐다"
        }
      }
    },
    {
      "when": {
        "prefix": "logo"
      },
      "enabled": {
        "prefix": {
          "size": 40
        }
      }
    },
    {
      "when": {
        "prefix": "cardArt"
      },
      "enabled": {
        "prefix": {
          "width": 56
        }
      }
    },
    {
      "when": {
        "prefix": "avatar"
      },
      "enabled": {
        "prefix": {
          "size": 36
        }
      }
    },
    {
      "when": {
        "selected": "current"
      },
      "enabled": {
        "radio": {
          "display": "켬"
        }
      }
    }
