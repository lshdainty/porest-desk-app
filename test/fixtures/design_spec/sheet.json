{
  "name": "Sheet",
  "source": "specs/components/sheet.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "9d344caf3f10"
  },
  "slots": {
    "container": "패널 — 가장자리에 붙는 floating 카드",
    "overlay": "뒤 dim",
    "header": "title + description 묶음",
    "title": "제목",
    "description": "설명(선택)",
    "footer": "버튼 줄(선택)",
    "close": "우상단 닫기 버튼(X)"
  },
  "axes": {
    "viewport": [
      "mobile",
      "desktop"
    ]
  },
  "defaults": {},
  "states": [
    "closed",
    "open",
    "closing"
  ],
  "rules": [
    {
      "when": {},
      "closed": {
        "container": {
          "padding": 24,
          "gap": 12,
          "borderWidth": 1,
          "borderColor": {
            "light": "#E5E8EF",
            "dark": "#404757"
          },
          "background": {
            "light": "#FFFFFF",
            "dark": "#242938"
          },
          "shadow": {
            "light": "0 24px 48px -8px rgba(15, 18, 28, 0.16), 0 8px 16px -4px rgba(15, 18, 28, 0.08)",
            "dark": "0 24px 48px -8px rgba(0, 0, 0, 0.60), 0 8px 16px -4px rgba(0, 0, 0, 0.30), inset 0 1px 0 0 rgba(255, 255, 255, 0.10)"
          },
          "height": "content auto",
          "zIndex": 101
        },
        "header": {
          "gap": 4
        },
        "footer": {
          "gap": 8
        },
        "title": {
          "typography": {
            "fontSize": 18,
            "fontWeight": 600,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 600
        },
        "description": {
          "typography": {
            "fontSize": 14,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          }
        },
        "close": {
          "width": 28,
          "height": 28,
          "iconSize": 16
        }
      },
      "open": {
        "container": {
          "mount": "mounted",
          "animation": "slide-in-from-{side}"
        },
        "overlay": {
          "animation": "fade-in-0"
        }
      },
      "closing": {
        "container": {
          "mount": "unmounting",
          "animation": "slide-out-to-{side}"
        },
        "overlay": {
          "animation": "fade-out-0"
        }
      }
    },
    {
      "when": {
        "viewport": "mobile"
      },
      "closed": {
        "container": {
          "width": "75%"
        }
      }
    },
    {
      "when": {
        "viewport": "desktop"
      },
      "closed": {
        "container": {
          "width": "≤384px"
        }
      }
    }
  ],
  "motion": {
    "open": {
      "duration": "500ms",
      "note": "`data-[state=open]:duration-500`"
    },
    "close": {
      "duration": "300ms",
      "note": "`data-[state=closed]:duration-300`"
    }
  },
  "notes": [
    {
      "rule": 0,
      "state": "closed",
      "slot": "container",
      "prop": "padding",
      "note": "`p-[var(--spacing-2xl)]`"
    },
    {
      "rule": 0,
      "state": "closed",
      "slot": "container",
      "prop": "gap",
      "note": "header/body/footer 사이"
    },
    {
      "rule": 0,
      "state": "closed",
      "slot": "container",
      "prop": "borderWidth",
      "note": "방향별 — `border-{l/r/t/b} border-border-default`"
    },
    {
      "rule": 0,
      "state": "closed",
      "slot": "container",
      "prop": "shadow",
      "note": "inline `var(--shadow-xl)`"
    },
    {
      "rule": 0,
      "state": "closed",
      "slot": "container",
      "prop": "height",
      "note": "top/bottom — (자동)"
    },
    {
      "rule": 0,
      "state": "closed",
      "slot": "container",
      "prop": "zIndex",
      "note": "z-modal-content — specs/z-index.md L2 표면(딤은 z-modal 100). 옛 값 50 은 층 표 · 레시피와 어긋나 있었다(v116 에서 맞춤)"
    },
    {
      "rule": 0,
      "state": "closed",
      "slot": "header",
      "prop": "gap",
      "note": "title ↔ description"
    },
    {
      "rule": 0,
      "state": "closed",
      "slot": "footer",
      "prop": "gap",
      "note": "footer button 사이"
    },
    {
      "rule": 1,
      "state": "closed",
      "slot": "container",
      "prop": "width",
      "note": "right/left — `w-3/4`"
    },
    {
      "rule": 2,
      "state": "closed",
      "slot": "container",
      "prop": "width",
      "note": "right/left — `sm:max-w-sm`"
    }
  ]
}
