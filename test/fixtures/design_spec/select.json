      "state": "enabled",
      "slot": "content",
      "prop": "width",
      "note": "트리거와 같은 폭 — 선택지 글은 목록 안에서 줄바꿈된다"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "content",
