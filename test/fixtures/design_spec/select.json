  "motion": {
    "누름 · 호버 — 바탕": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "background-color"
      ]
    },
    "누름 — 콘텐츠": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "scale"
      ],
      "note": "트리거 · 선택지의 콘텐츠만 2px 거리 축소 — 모션 줄이기면 하지 않는다"
    },
    "셰브론 — 열 때": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "rotate"
      ]
    },
    "셰브론 — 닫을 때": {
      "duration": "100ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "rotate"
      ]
    },
    "목록 — 열 때": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "opacity",
        "scale"
      ],
      "note": "0.95 → 1 · 투명 → 불투명. 붙은 쪽(트리거 쪽)에서 커진다"
    },
    "목록 — 닫을 때": {
      "duration": "100ms",
      "easing": "cubic-bezier(0.35, 0, 1, 1)",
      "properties": [
        "opacity",
        "scale"
      ],
      "note": "1 → 0.95 · 사라진다. 모션 줄이기면 투명도만"
    },
    "선택지 — 알약": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "background-color",
        "inset"
      ],
      "note": "알약 바탕이 나타나며 좌우 8 들어온다"
    },
    "오류 — 테두리": {
      "duration": "100ms",
      "easing": "cubic-bezier(0.35, 0, 0.35, 1)",
      "properties": [
        "border-color"
      ]
    }
  },
  "notes": [
    {
      "rule": 0,
      "state": "enabled",
      "slot": "trigger",
      "prop": "borderWidth",
      "note": "상자 안쪽(inset). 오류의 2px 는 안쪽에 덧그린다"
    },
    {
