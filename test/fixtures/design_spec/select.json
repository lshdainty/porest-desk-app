    {
      "rule": 1,
      "state": "enabled",
      "slot": "item",
      "prop": "height",
      "note": "한 줄 — 설명이 있으면 66"
    },
    {
      "rule": 2,
      "state": "enabled",
      "slot": "item",
      "prop": "height",
      "note": "한 줄 — 설명이 있으면 57"
