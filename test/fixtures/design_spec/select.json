  "slots": {
    "trigger": "트리거 — Input Button 과 같은 상자. 누르면 목록이 열린다",
    "value": "고른 값 — 한 줄. 여럿이면 쉼표로 잇고, 넘치면 \"첫 값 외 N개\"",
    "placeholder": "고르기 전의 글 — \"{값의 종류} 선택\"(\"결제 수단 선택\"). 라벨만 그대로 두지 않는다",
    "prefixIcon": "트리거 앞 아이콘 — 하나를 고르면 그 선택지의 아이콘으로 바뀐다",
    "chevron": "셰브론 — 열리면 180° 돈다",
    "focusRing": "트리거의 키보드 포커스 링(웹)",
    "content": "목록 — 칸 폭 그대로, 칸 아래(모자라면 위) 8",
    "item": "선택지 한 줄 — 글은 목록 안에서 줄바꿈된다",
    "itemIcon": "선택지 앞 아이콘",
    "itemLabel": "선택지 글 — 명사형으로 짧게",
    "itemDescription": "선택지 설명 — 한 줄. 트리거에는 보이지 않는다",
    "indicator": "고른 표시 — 오른쪽 체크. 바탕 · 굵기는 바꾸지 않는다",
    "highlight": "누름 · 호버 · 키보드 위치 — 좌우 8 들인 알약",
    "groupLabel": "묶음 제목",
    "divider": "묶음 사이 선 — 선택지 사이에는 없다"
  },
  "axes": {
    "size": [
      "large",
      "medium",
      "responsive"
    ]
  },
  "defaults": {
    "size": "responsive"
  },
  "states": [
    "enabled",
    "pressed",
    "focused",
    "open",
    "selected",
    "invalid",
    "disabled",
    "readonly"
  ],
