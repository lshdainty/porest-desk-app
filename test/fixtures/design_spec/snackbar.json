{
  "name": "Snackbar",
  "source": "specs/components/snackbar.yaml",
  "design": {
    "file": "DESIGN.desk.md",
    "sha256": "9d344caf3f10"
  },
  "slots": {
    "region": "자리 — 화면 아래 가운데. 탭 바 · 플로팅 버튼 · 바닥 버튼을 피해 그 위에 선다",
    "root": "띠 — 짙은 바탕(다크는 밝은 띠), 한 번에 하나",
    "icon": "아이콘 — 성공 · 실패에만",
    "content": "글과 액션 — 양 끝에 놓는다",
    "message": "글 — 무엇이 됐는지 먼저, 줄이지 않는다",
    "action": "액션 — 하나, 동작 이름(되돌리기 · 잔액 고치기)",
    "closeButton": "보조 기술용 닫기 — 보이지 않고, 키보드 초점이 오면 띠 오른쪽 끝에 보인다",
    "focusRing": "키보드 포커스 링(웹)"
  },
  "axes": {
    "tone": [
      "neutral",
      "positive",
      "critical"
    ]
  },
  "defaults": {
    "tone": "neutral"
  },
  "states": [
    "enabled",
    "pressed",
    "focused"
  ],
  "rules": [
    {
      "when": {},
      "enabled": {
        "region": {
          "paddingX": 8,
          "paddingBottom": 8,
          "zIndex": 400
        },
        "root": {
          "width": "100%",
          "maxWidth": 464,
          "minHeight": 44,
          "padding": 10,
          "radius": 8,
          "background": {
            "light": "#1A1F2E",
            "dark": "#F5F6FA"
          },
          "shadow": "none",
          "duration": "4000ms"
        },
        "icon": {
          "size": 24,
          "paddingRight": 2
        },
        "content": {
          "paddingX": 6,
          "gap": 10
        },
        "message": {
          "typography": {
            "fontSize": 14,
            "lineHeight": 19,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 400,
          "foreground": {
            "light": "#FFFFFF",
            "dark": "#242938"
          }
        },
        "action": {
          "typography": {
            "fontSize": 14,
            "lineHeight": 19,
            "fontWeight": 400,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 700,
          "foreground": {
            "light": "#7AA9F6",
            "dark": "#0147AD"
          },
          "touchTarget": "글 + 좌우 8 × 44",
          "radius": 4
        },
        "closeButton": {
          "size": 44,
          "iconSize": 16,
          "color": {
            "light": "#FFFFFF",
            "dark": "#242938"
          },
          "radius": 8,
          "margin": "위 · 아래 · 오른쪽 −10"
        }
      },
      "pressed": {
        "action": {
          "scale": "2px 거리 축소",
          "scaleDuration": "150ms",
          "scaleEasing": "cubic-bezier(0, 0, 0.15, 1)"
        }
      },
      "focused": {
        "focusRing": {
          "width": 2,
          "offset": -4,
          "actionOffset": 2,
          "color": {
            "light": "#FFFFFF",
            "dark": "#242938"
          }
        }
      }
    },
    {
      "when": {
        "tone": "positive"
      },
      "enabled": {
        "icon": {
          "color": {
            "light": "#25C062",
            "dark": "#167F3F"
          }
        }
      }
    },
    {
      "when": {
        "tone": "critical"
      },
      "enabled": {
        "icon": {
          "color": {
            "light": "#FF8477",
            "dark": "#D72323"
          }
        }
      }
    }
  ],
  "motion": {
    "나타남": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "scale 0.8 → 1",
        "opacity 0 → 1"
      ],
      "note": "가운데를 기준점으로 — 모션 줄이기면 투명도만(v104)"
    },
    "사라짐": {
      "duration": "100ms",
      "easing": "cubic-bezier(0.35, 0, 1, 1)",
      "properties": [
        "scale → 0.8",
        "opacity → 0"
      ]
    },
    "새 것으로 바꿈": {
      "duration": "100ms",
      "easing": "cubic-bezier(0.35, 0, 1, 1)",
      "properties": [
        "지금 것 사라짐 → 새 것 나타남"
      ],
      "note": "한 번에 하나 — 새 것이 오면 지금 것을 바로 바꾼다"
    }
  },
  "notes": [
