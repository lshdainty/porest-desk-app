<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 스토어를 안 쓰니 앱이 새 APK 를 직접 받아 설치 화면을 띄운다.
         이 권한이 없으면 받아 놓고도 설치로 넘어가지 못한다(Android 8+).
         설치 자체는 시스템이 사용자에게 다시 묻는다 — 조용히 깔리는 길은 없다. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 13+ 는 알림도 권한이다. 없으면 알림만 안 뜨고 보관함에는 쌓인다.

         결제 문자는 RECEIVE_SMS 로 직접 받지 않는다 — 그 권한이 붙은 앱을 브라우저·
         메신저로 설치하면 Play Protect 가 자동 차단해(금융사기 악성앱이 쓰는 조합)
         사이드로드 배포 자체가 막힌다. 문자도 기본 메시지 앱의 알림으로 읽어
         아래 알림 접근 하나로 합쳤다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 앱 잠금(생체인증) — BiometricPrompt(지문·얼굴) 사용. 런타임 팝업 없는 일반 권한. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- open_filex 가 딸고 오는 미디어 권한을 뺀다.
         APK 를 앱 전용 캐시에 받아 열 뿐이라 사진·동영상·오디오를 읽을 일이 없는데,
         그냥 두면 앱 정보에 그 권한들이 뜬다. 설치 화면이 안 열리면 이걸 의심할 것. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <application
        android:label="Porest Desk"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:taskAffinity="">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- OAuth 콜백 딥링크 — 시스템 브라우저 로그인이 porestdesk://oauth/callback
                 302 로 복귀한다. autoVerify 는 https App Links 전용이라 커스텀스킴엔 없음.
                 스킴 하이재킹은 PKCE(code_verifier)+state 검증이 막는다(RFC 8252). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="porestdesk" android:host="oauth"/>
            </intent-filter>
        </activity>
        <!-- 카드사 앱 결제 알림 읽기.
             카드사들이 승인 내역을 문자 대신 자사 앱 푸시로 보내는 쪽으로 옮겨 가서,
             문자만 봐서는 카드에 따라 아무것도 안 잡힌다.

             알림 접근은 기기의 모든 알림을 볼 수 있는 특수 권한이라 런타임 팝업으로
             받을 수 없고 사용자가 설정에서 직접 켜야 한다. 서비스는 등록해 두되,
             켜지기 전까지는 시스템이 바인딩하지 않아 아무 일도 하지 않는다.
             읽는 대상은 PaymentAppPackages 에 적힌 카드사·은행 앱으로 한정한다
             (체크카드는 발급 주체가 은행이라 결제 알림이 은행 앱에서 온다). -->
        <service
            android:name=".PaymentNotificationListener"
            android:exported="false"
            android:label="@string/card_noti_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
