<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 스토어를 안 쓰니 앱이 새 APK 를 직접 받아 설치 화면을 띄운다.
         이 권한이 없으면 받아 놓고도 설치로 넘어가지 못한다(Android 8+).
         설치 자체는 시스템이 사용자에게 다시 묻는다 — 조용히 깔리는 길은 없다. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 카드 결제 문자를 읽어 가계부에 옮겨 적기 위한 권한.
         설정에서 사용자가 켤 때만 요청한다 — 기본은 꺼져 있고, 거절해도 앱의 나머지
         기능은 그대로 쓴다. 수신한 문자는 결제 문자 판정을 통과한 것만 기기 안
         보관함에 남고, 서버로는 사용자가 확인 화면에서 저장할 때만 올라간다. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Android 13+ 는 알림도 권한이다. 없으면 알림만 안 뜨고 보관함에는 쌓인다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- open_filex 가 딸고 오는 미디어 권한을 뺀다.
         APK 를 앱 전용 캐시에 받아 열 뿐이라 사진·동영상·오디오를 읽을 일이 없는데,
         그냥 두면 앱 정보에 그 권한들이 뜬다. 설치 화면이 안 열리면 이걸 의심할 것. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <application
        android:label="Porest Desk"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:taskAffinity="">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- OAuth 콜백 딥링크 — 시스템 브라우저 로그인이 porestdesk://oauth/callback
                 302 로 복귀한다. autoVerify 는 https App Links 전용이라 커스텀스킴엔 없음.
                 스킴 하이재킹은 PKCE(code_verifier)+state 검증이 막는다(RFC 8252). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="porestdesk" android:host="oauth"/>
            </intent-filter>
        </activity>
        <!-- 결제 문자 수신 — 앱이 꺼져 있어도 받는다.
             exported 는 필수다(시스템이 보내는 브로드캐스트를 받아야 한다).
             권한이 없으면 브로드캐스트 자체가 오지 않으므로 리시버는 조용히 논다. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
